<div id="q-other-outputs" class="question">
  <div class="answer">
    <p>We use <a href="{{ globals.linkUrl }}" target="_blank">{{ globals.fullName }}</a> for planning our data management and creating this DMP. The management and planning of other research outputs is done separately and is included in this Section. Still, we benefit from data stewardship guidance (e.g. FAIR principles, openness, or security) and it is reflected in our plans with respect to other research outputs.</p>

    {%- if data.dmp.outputsRetentionCriteriaDescription is not none -%}
        <p>We decide which additional research outputs should be retained as follows: {{ data.dmp.outputsRetentionCriteriaDescription._value }}{{ macros.linkQuestion(data.dmp.outputsRetentionCriteriaDescription._path) }}</p>
    {%- endif -%}

    {% if data.dmp.areOtherOutputs._value is sameas true and data.dmp.otherOutputs|length > 0 %}
        <p>There are additional research outputs beyond those already described above:</p>
        <ul>
            {%- for output in data.dmp.otherOutputs -%}
                <li>
                    <strong>{{ output.description._value or "No description" }}</strong>{% if output.description._value %}{{ macros.linkQuestion(output.description._path) }}{% endif %}
                    {%- if output.whyImportant -%}
                        <br>This output is important because: {{ output.whyImportant._value }}{{ macros.linkQuestion(output.whyImportant._path) }}
                    {% endif %}
                    {%- if output.whoWillUse -%} 
                        <br>Intended users: {{ output.whoWillUse._value }}{{ macros.linkQuestion(output.whoWillUse._path) }}
                    {% endif %}
                    {%- if output.isAvailable is not none -%}
                        {% if output.isAvailable._value is sameas true %}
                            <br>This output will be available{% if output.whereAvailable %} ({{ output.whereAvailable._value }}).{{ macros.linkQuestion(output.whereAvailable._path) }}{%- else -%}.{{ macros.linkQuestion(output.isAvailable._path) }}{% endif %}
                        {%- elif output.isAvailable._value is sameas false  -%}
                            <br>This output will not be available{% if output.noAvailableReason %} (because: {{ output.noAvailableReason._value }}).{{ macros.linkQuestion(output.noAvailableReason._path) }}{%- else -%}.{{ macros.linkQuestion(output.isAvailable._path) }}{% endif %}
                        {%- endif -%}
                    {%- endif -%}
                </li>
            {%- endfor -%}
        </ul>
    {%- elif data.dmp.areOtherOutputs._value is sameas false -%}
        {%- if data.dmp.datasets|length == 1 -%}
            <p>There are no other research output than the dataset described above.{{ macros.linkQuestion(data.dmp.areOtherOutputs._path) }}</p>
        {%- elif data.dmp.datasets|length > 1 -%}
            <p>There are no other research outputs than datasets described above.{{ macros.linkQuestion(data.dmp.areOtherOutputs._path) }}</p>
        {%- else -%}
            <p>There are no other research outputs planned.{{ macros.linkQuestion(data.dmp.areOtherOutputs._path) }}</p>
        {%- endif -%}
    {%- endif -%}
  </div>
</div>
