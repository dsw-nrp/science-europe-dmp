<div id="q-reusable" class="question">
  <div class="answer">
    {# Produced datasets #}
    {%- if data.dmp.datasets|length > 0 -%}
        <p>This section provides details on how the data will be prepared for broad reuse, including licensing strategies, documentation practices, data quality assurance, and the inclusion of provenance and methodological information to support validation and future use.</p>
        {%- for dataset in data.dmp.datasets -%}
            <h4>
                {%- if dataset.name._raw -%}
                    <strong><a href="{{ dataset.name._raw.homepage }}" target="_blank">{{ dataset.name._raw.name }}</a></strong>{{ macros.linkQuestion(dataset.name._path) }}
                {%- elif dataset.name -%}
                    <strong>{{ dataset.name._value }}</strong>{{ macros.linkQuestion(dataset.name._path) }}
                {%- else -%}
                    <strong>(no name given)</strong>
                {%- endif -%}
                {# If will be published #}
                {%- if dataset.isPublished._value is sameas true %} (published){{ macros.linkQuestion(dataset.isPublished._path) }}
                {%- elif dataset.isPublished._value is sameas false %} (not published){{ macros.linkQuestion(dataset.isPublished._path) }}
                {%- endif -%}:
            </h4>

            {# Measure quality #}
            {%- if dataset.collection -%}
                {%- set collection = dataset.collection -%}
                {%- if collection.isEquipmentCollection._value is sameas true -%}
                    {%- set quality_process_labels = {
                        "calibration": "calibrating measures",
                        "repeatSamples": " conducting repeat samples or repeating measurements to monitor the consistency of the results",
                        "standardizedMethods": "use standardized methods for data capture and recording",
                        "dataEntryValidation": "doing data entry validation",
                        "dataPeerReview": "using data peer review",
                        "usesControlledVocabularies": "using controlled vocabularies",
                        "knownOutcomeSamples": "measuring samples with known outcomes to monitor consistency",
                    } -%}
                    {%- set used_processes = [] -%}
                    {%- for key, label in quality_process_labels.items() -%}
                        {%- if collection.equipmentCollection.qualityProcesses[key] and collection.equipmentCollection.qualityProcesses[key]._value is sameas true and label -%}
                        {%- do used_processes.append(label) -%}
                        {%- endif -%}
                    {%- endfor -%}
                    {%- if used_processes|length > 0 -%}
                        <p>During equipment collection of this dataset, the following quality assurance processes will be used: 
                        {{ used_processes|join(", ") }}{% if collection.equipmentCollection.qualityProcesses.otherQualityProcesses and collection.equipmentCollection.qualityProcesses.otherQualityProcesses._value %}, {{ collection.equipmentCollection.qualityProcesses.otherQualityProcesses._value }}{% endif %}.{{ macros.linkQuestion(collection.equipmentCollection.usesQualityProcesses._path) }}
                        </p>
                    {%- endif -%}
                {%- endif -%}
            {%- endif -%}
                
            {# Validating the integrity of the results #}
            {%- if dataset.processingEnvironment -%}
                {%- set processingEnvironment = dataset.processingEnvironment -%}
                {%- if processingEnvironment.isMonitoringIntegrityAfterProcessing._value is sameas true and processingEnvironment.monitoringIntegrityAfterProcessing|length > 0 -%}
                    <p>To validate the integrity of the results, the following will be done: {{ processingEnvironment.monitoringIntegrityAfterProcessing|map(attribute='_label')|map('lower')|join(", ") }}.{{ macros.linkQuestion(processingEnvironment.isMonitoringIntegrityAfterProcessing._path) }}</p>
                {%- endif -%}
            {%- endif -%}

            {# Can open data #}
            {%- if dataset.reuseRestriction -%}
                {%- if dataset.reuseRestriction.accessRestriction.canDataOpen._value is sameas true -%}
                    <p>As stated already in Section 2.2, all of our data can become completely open over time.{{ macros.linkQuestion(dataset.reuseRestriction.accessRestriction.canDataOpen._path) }}</p>
                {%- elif dataset.reuseRestriction.accessRestriction.canDataOpen._value is sameas false -%}
                    <p>As explained in Section 2.2, our data cannot become completely open.{{ macros.linkQuestion(dataset.reuseRestriction.accessRestriction.canDataOpen._path) }}</p>
                    {%- set dataCannotOpen = dataset.reuseRestriction.accessRestriction.dataCannotOpen -%}

                    {%- if dataCannotOpen.isLegalReason._value is sameas true -%}
                        {%- if dataCannotOpen.legalReason.isPrivacyReason._value is sameas true -%}
                        <p>
                            {%- if dataCannotOpen.legalReason.privacyReason.locationOfData._value == "no" %}
                                There are no restrictions on where the data need to be stored related to the privacy reasons.{{ macros.linkQuestion(dataCannotOpen.legalReason.privacyReason.locationOfData._path) }}
                            {%- elif dataCannotOpen.legalReason.privacyReason.locationOfData._value == "eu" %}
                                Due to privacy reasons, the data must stay in the EU.{{ macros.linkQuestion(dataCannotOpen.legalReason.privacyReason.locationOfData._path) }}
                            {%- elif dataCannotOpen.legalReason.privacyReason.locationOfData._value == "country" %}
                                Due to privacy reasons, the data must stay in the same country.{{ macros.linkQuestion(dataCannotOpen.legalReason.privacyReason.locationOfData._path) }}
                            {%- elif dataCannotOpen.legalReason.privacyReason.locationOfData._value == "institute" %}
                                Due to privacy reasons, the data must stay in the same institute.{{ macros.linkQuestion(dataCannotOpen.legalReason.privacyReason.locationOfData._path) }}
                            {%- endif -%}

                            {%- set privacyCanUse = [] -%}
                            {%- set privacyCannotUse = [] -%}
                            {%- set privacyReason = dataCannotOpen.legalReason.privacyReason -%}
                            {%- if privacyReason.howToMoreOpen.pseudonymization._value is sameas false -%}
                                {%- do privacyCannotUse.append("pseudonymization") -%}
                            {%- elif privacyReason.howToMoreOpen.pseudonymization._value is sameas true -%}
                                {%- do privacyCanUse.append("pseudonymization") -%}
                            {%- endif -%}
                            {%- if privacyReason.howToMoreOpen.anonymization._value is sameas false -%}
                                {%- do privacyCannotUse.append("anonymization") -%}
                            {%- elif privacyReason.howToMoreOpen.anonymization._value is sameas true -%}
                                {%- do privacyCanUse.append("anonymization") -%}
                            {%- endif -%}
                            {%- if privacyReason.howToMoreOpen.aggregation._value is sameas false -%}
                                {%- do privacyCannotUse.append("data aggregation") -%}
                            {%- elif privacyReason.howToMoreOpen.aggregation._value is sameas true -%}
                                {%- do privacyCanUse.append("data aggregation") -%}
                            {%- endif -%}

                            {%- if privacyCanUse|length == 1 %}
                                We can use {{privacyCanUse[0]}} to make the data more openly available.
                            {%- elif privacyCanUse|length == 2 %}
                                We can use {{privacyCanUse[0]}} and {{privacyCanUse[1]}} to make the data more openly available.
                            {%- elif privacyCanUse|length == 3 %}
                                We can use {{privacyCanUse[0]}}, {{privacyCanUse[1]}}, and {{privacyCanUse[2]}} to make the data more openly available.
                            {%- endif -%}

                            {%- set privacyCannotUseStart = "We cannot use" if privacyCanUse|length == 0 else "But we cannot use" -%}
                            {%- if privacyCannotUse|length == 1 %}
                                {{privacyCannotUseStart}} {{privacyCannotUse[0]}} to make the data more openly available.
                            {%- elif privacyCannotUse|length == 2 %}
                                {{privacyCannotUseStart}} neither {{privacyCannotUse[0]}} nor {{privacyCannotUse[1]}} to make the data more openly available.
                            {%- elif privacyCannotUse|length == 3 %}
                                {{privacyCannotUseStart}} neither {{privacyCannotUse[0]}} nor {{privacyCannotUse[1]}}, nor {{privacyCannotUse[2]}} to make the data more openly available.
                            {%- endif -%}

                            {%- if privacyReason.howToMoreOpen.pseudonymization._value is sameas true -%}
                                {%- if privacyReason.howToMoreOpen.useThirdPartyForPseudonymization._value is sameas false %}
                                    For pseudonymization, we cannot make use of an existing 'trusted third party'.{{ macros.linkQuestion(privacyReason.howToMoreOpen.useThirdPartyForPseudonymization._path) }}
                                {%- elif privacyReason.howToMoreOpen.useThirdPartyForPseudonymization._value is sameas true %}
                                    For pseudonymization, we can make use of an existing 'trusted third party'.{{ macros.linkQuestion(privacyReason.howToMoreOpen.useThirdPartyForPseudonymization._path) }}
                                {%- endif -%}
                            {%- endif -%}
                        </p>
                        {%- endif -%}

                        {# Access to private data - leave out, complete access is described in Section 2.2 #}
                        {%- if dataCannotOpen.legalReason.isAuthenticatedAccess._value is sameas true -%}
                            <p>A procedure for authorized users to access the data is described in Section 2.2.{{ macros.linkQuestion(dataCannotOpen.legalReason.isAuthenticatedAccess._path) }}</p>
                        {%- endif -%}

                        {# Intellectual Property #}
                        {%- if dataCannotOpen.legalReason.isIntellectualPropertyReason._value is sameas true -%}
                        <p>
                            {%- set intellectualPropertyReason = dataCannotOpen.legalReason.intellectualPropertyReason %}
                            There are IP reasons why our data can not be open.{{ macros.linkQuestion(dataCannotOpen.legalReason.isIntellectualPropertyReason._path) }}
                            {%- if intellectualPropertyReason.isOwnershipOfDataDefined._value is sameas true %}
                                It is clear who owns data and documents.{{ macros.linkQuestion(intellectualPropertyReason.isOwnershipOfDataDefined._path) }}
                            {%- endif -%}
                            {%- if intellectualPropertyReason.isDecisionPowerOfMovingDataDefined._value is sameas true %}
                                Someone will be given the decision power to move documents or data to a new place after the {{globals.projects}} has finished.{{ macros.linkQuestion(intellectualPropertyReason.isDecisionPowerOfMovingDataDefined._path) }}
                            {%- endif -%}
                        </p>
                        {%- elif  dataCannotOpen.legalReason.isIntellectualPropertyReason._value is sameas false %}
                            <p>There are no IP reasons why our data can not be open.{{ macros.linkQuestion(dataCannotOpen.legalReason.isIntellectualPropertyReason._path) }}</p>
                        {%- endif -%}
                    {%- endif -%}
                {%- endif -%}
            {%- endif -%}

            {# Cold storage #}
            {%- if dataset.preservationStrategy  -%}
                {%- if dataset.preservationStrategy.usesLongTermStorageDuringProject._value is sameas false -%}
                    <p>We do not plan to be archiving data (using so-called <em>cold storage</em>) for long term preservation already during the {{globals.projects}}.{{ macros.linkQuestion(dataset.preservationStrategy.usesLongTermStorageDuringProject._path) }}</p>
                {%- elif dataset.preservationStrategy.usesLongTermStorageDuringProject._value is sameas true -%}
                    <p>
                    We will be archiving data (using so-called <em>cold storage</em>) for long term preservation already <em>during</em> the {{globals.projects}}.{{ macros.linkQuestion(dataset.preservationStrategy.usesLongTermStorageDuringProject._path) }}
                    {%- if dataset.preservationStrategy.longTermStorageDuringProject.isLongTermDataUsabilityEnsured._value is sameas true %}
                        The data are expected to be still understandable and reusable after a long time.{{ macros.linkQuestion(dataset.preservationStrategy.longTermStorageDuringProject.isLongTermDataUsabilityEnsured._path) }}
                    {%- endif -%}
                    {# How long will be stored data #}
                    {%- set period = dataset.preservationStrategy.longTermStorageDuringProject.archivePeriod -%}
                    {%- if period._value -%}
                        {%- if period._value == "as_long_as_possible" %}
                            This data set will be kept available as long as technically possible.
                        {%- elif period._value == "until_needs_delete" %}
                            This data set will be kept available until it needs to be deleted for legal, contractual or regulatory reasons.
                        {%- elif period._value %}
                            This data set will be kept available for a fixed period of {{ period._value }}.
                        {%- endif -%}
                        {{ macros.linkQuestion(period._path) }}
                    {%- endif -%}
                    </p>
                {%- endif -%}
                {%- if dataset.preservationStrategy.usesLongTermStorageAfterProject._value is sameas true -%}
                    <p>We will be archiving data (using so-called <em>cold storage</em>) for long term preservation <em>after</em> the {{globals.projects}}.{{ macros.linkQuestion(dataset.preservationStrategy.usesLongTermStorageAfterProject._path) }}
                    {%- set period = dataset.preservationStrategy.longTermStorageAfterProject.minimumLifeTimeYears -%}
                    {%- if period._value -%}
                        {%- if period._value == "5" %}
                            This data set will be kept available for a minimum of 5 years after the project ends.
                        {%- elif period._value == "10" %}
                            This data set will be kept available for a minimum of 10 years after the project ends.
                        {%- elif period._value == "15" %}
                            This data set will be kept available for a minimum of 15 years after the project ends.
                        {%- elif period._value %}
                            This data set will be kept available for a minimum of {{ period._value }} years after the project ends.
                        {%- endif -%}
                        {{ macros.linkQuestion(period._path) }}
                    {%- endif -%}
                    </p>
                {%- endif -%}
            {%- endif -%}

            {%- if dataset.metadata -%}
                {# Good provenance (lab notebooks) #}
                <p>
                {%- if dataset.metadata.isProvenanceDocumented._value is sameas true -%}
                    {%- if dataset.metadata.provenanceDocumented.provenanceDocumentedType -%}
                        {%- if dataset.metadata.provenanceDocumented.provenanceDocumentedType._value == "lab_notebook" -%}
                            We will use lab notebooks to make sure that there is good provenance of the data analysis.
                        {%- elif dataset.metadata.provenanceDocumented.provenanceDocumentedType._value == "electronic_lab_notebook" -%}
                            We will use an electronic lab notebook to make sure that there is good provenance of the data analysis.
                        {%- elif dataset.metadata.provenanceDocumented.provenanceDocumentedType._value == "system" -%}
                            Our computing workflow system keeps provenance information to ensure the good provenance of the data analysis.
                        {%- elif dataset.metadata.provenanceDocumented.provenanceDocumentedType -%}
                            We will use other solution than (electronic) lab notebooks to make sure that there is good provenance of the data analysis{{ ": " ~ dataset.metadata.provenanceDocumented.provenanceDocumentedType._value }}
                        {%- endif -%}
                        {{ macros.linkQuestion(dataset.metadata.provenanceDocumented.provenanceDocumentedType._path) }}
                    {%- endif -%}

                    {%- if dataset.metadata.provenanceDocumented.usesStandard._value is sameas true -%}
                        {%- if dataset.metadata.provenanceDocumented.standardProvenanceUsed %}
                            For documenting the provenance, we will use the following standard: <em>{{ dataset.metadata.provenanceDocumented.standardProvenanceUsed._value }}</em>.{{ macros.linkQuestion(dataset.metadata.provenanceDocumented.standardProvenanceUsed._path) }}
                        {%- else %}
                            For documenting provenance we will use a standard (no specific standard has been provided).{{ macros.linkQuestion(dataset.metadata.provenanceDocumented.usesStandard._path) }}
                        {%- endif -%}

                    {%- elif dataset.metadata.provenanceDocumented.usesStandard._value is sameas false -%}
                        {%- if dataset.metadata.provenanceDocumented.noStandardReason._value == "no_standard" %}
                            For documenting provenance we will not use a standard because there is no standard in our {{globals.project}} area.{{ macros.linkQuestion(dataset.metadata.provenanceDocumented.noStandardReason._path) }}
                        {%- elif dataset.metadata.provenanceDocumented.noStandardReason._value %}
                            For documenting provenance we will not use a standard because: {{ dataset.metadata.provenanceDocumented.noStandardReason._value }}.{{ macros.linkQuestion(dataset.metadata.provenanceDocumented.noStandardReason._path) }}
                        {%- else %}
                            We will not use a standard for documenting provenance.{{ macros.linkQuestion(dataset.metadata.provenanceDocumented.usesStandard._path) }}
                        {%- endif -%}

                    {%- endif -%}

                {%- elif dataset.metadata.isProvenanceDocumented._value is sameas false -%}
                    Provenance is not documented for this dataset{%- if dataset.metadata.noProvenanceReason %} because: {{ dataset.metadata.noProvenanceReason._value }}{{ macros.linkQuestion(dataset.metadata.noProvenanceReason._path) }}{%- else -%}.{{ macros.linkQuestion(dataset.metadata.isProvenanceDocumented._path) }}{%- endif -%}
                {%- endif -%}
                </p>
                {# Metadata after no longer data #}
                {%- if dataset.metadata.isAvailableAfterDataNotAvailable._value is sameas true -%}
                    <p>Metadata will be available after the data are no longer available.{{ macros.linkQuestion(dataset.metadata.isAvailableAfterDataNotAvailable._path) }}
                    {%- if dataset.metadata.howAvailableGuaranteed %} We will ensure it by: {{ dataset.metadata.howAvailableGuaranteed._value }}.{{ macros.linkQuestion(dataset.metadata.howAvailableGuaranteed._path) }}
                    {%- endif -%}</p>
                {%- elif dataset.metadata.isAvailableAfterDataNotAvailable._value is sameas false -%}
                    <p>Metadata will not be available after the data are no longer available{% if dataset.metadata.noAvailableReason._value %} because: {{ dataset.metadata.noAvailableReason._value }}{{ macros.linkQuestion(dataset.metadata.noAvailableReason._path) }}{%- else -%}.{{ macros.linkQuestion(dataset.metadata.isAvailableAfterDataNotAvailable._path) }}{% endif %}</p>
                {%- endif -%}
            {%- endif -%}

            {# Documentation #}
            {%- if dataset.reuseRestriction -%}
                {%- if dataset.reuseRestriction.accessRestriction -%}
                    {%- if dataset.reuseRestriction.accessRestriction.isDocumentationAvailable._value is sameas true -%}
                        <p>Documentation of this dataset will be available to others.{{ macros.linkQuestion(dataset.reuseRestriction.accessRestriction.isDocumentationAvailable._path) }}
                        {%- if dataset.documentation -%}
                            {%- set documentation = dataset.documentation -%}
                            {%- if documentation.description._value %}
                                It will cover: {{ documentation.description._value|e }}.{{ macros.linkQuestion(documentation.description._path) }}
                            {%- endif -%}
                            {%- set included_items = [] -%}
                            {%- if documentation.includeMethodology._value is sameas true -%}
                                {%- do included_items.append("methodology of data collection") -%}
                            {%- endif -%}
                            {%- if documentation.includeDataValidation._value is sameas true -%}
                                {%- do included_items.append("information on performed data validation") -%}
                            {%- endif -%}
                            {%- if included_items|length > 0 %}
                                {{ included_items|join(" and ")|capitalize }} {{ "is" if included_items|length == 1 else "are" }} included in the documentation{% if documentation.description._value %} as well{% endif %}.
                            {%- endif -%}
                            {%- if documentation.format._value %}
                                It is available in the following format: {{ documentation.format._value|e }}.{{ macros.linkQuestion(documentation.format._path) }}
                            {%- endif -%}
                        {%- endif -%}
                        </p>
                    {%- elif dataset.reuseRestriction.accessRestriction.isDocumentationAvailable._value is sameas false -%}
                        <p>Documentation of this dataset is not available{% if dataset.reuseRestriction.accessRestriction.noDocumentationAvailableReason._value %} because {{ dataset.reuseRestriction.accessRestriction.noDocumentationAvailableReason._value }}{{ macros.linkQuestion(dataset.reuseRestriction.accessRestriction.noDocumentationAvailableReason._path) }}{%- else -%}.{{ macros.linkQuestion(dataset.reuseRestriction.accessRestriction.isDocumentationAvailable._path) }}{% endif %}</p>
                    {%- endif -%}
                {%- endif -%}
            {%- endif -%}
        {%- endfor -%}
    {%- endif -%}
  </div>
</div>
