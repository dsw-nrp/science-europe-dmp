<div id="q-how-data" class="question">
  <h3>1. How will new data be collected or produced and/or how will existing data be re-used?</h3>
    <div class="answer">
    {# Generated datasets #}
    <h4>Generated datasets</h4>

    {% if data.dmp.datasets | length > 0 %}
        {%- if data.dmp.sharedResources.collections | length > 0 -%}
            {% if data.dmp.sharedResources.collections | length > 1 %}
                <p>In our {{ globals.projects }}, {{ data.dmp.sharedResources.collections | length }} distinct collection processes will be used to gather and generate research data:</p>
            {% elif data.dmp.sharedResources.collections | length == 1 %}
                <p>In our {{ globals.projects }}, a single collection process will be used to collect and generate research data:</p>
            {% endif %}
            <ul>
            {% for collection in data.dmp.sharedResources.collections %}
                <li style="margin-bottom: 2em;">

                {{ macros.datasetIntro(collection, "data collection processes", data.dmp.datasets) }}

                {# --- Measuring equipment collection --- #}
                {% if collection.isEquipmentCollection._value is sameas true %}
                    {% set equipmentCollection = collection.equipmentCollection %}
                    <p>
                    This collection process involves the use of measuring equipment{{ "s" if equipmentCollection.instruments|length > 1 else "" }}.{{ macros.linkQuestion(collection.isEquipmentCollection._path) }}
                    {% if equipmentCollection.instruments | length > 0 %}
                    The following instruments will be used:
                    <ul>
                        {% for instrument in equipmentCollection.instruments %}
                        <li>
                            <strong>{{ instrument.name._value if instrument.name else "(no name given)" }}</strong>
                            {{ macros.linkQuestion(instrument.name._path) }}
                        </li>
                        {% endfor %}
                    </ul>
                    {% endif %}
                    </p>

                    {# Who will collect #}
                    {%- if equipmentCollection.whoMeasures._value == "experts_own_equipment" %}
                        This dataset will be collected by experts in the {{globals.projects}}, with our own equipment.{{ macros.linkQuestion(equipmentCollection.whoMeasures._path) }}
                    {%- elif equipmentCollection.whoMeasures._value == "experts_spec_infrastructure" %}
                        This dataset will be collected by experts in the {{globals.projects}}, at a specialized infrastructure.{{ macros.linkQuestion(equipmentCollection.whoMeasures._path) }}
                    {%- elif equipmentCollection.whoMeasures._value == "external_party" %}
                        This dataset will be collected by an external party{{ macros.linkQuestion(equipmentCollection.whoMeasures._path) }}
                        {%- if equipmentCollection.externalPartyControlOverData._value -%}
                            {%- if equipmentCollection.externalPartyControlOverData._value == "external_party" %} 
                                and they will also have control over the data.
                            {%- elif equipmentCollection.externalPartyControlOverData._value == "project_partners" -%} 
                                and the control over the data is equally shared between all project partners.
                            {%- elif equipmentCollection.externalPartyControlOverData %} 
                                and for the control over the data we have made following arrangements: {{equipmentCollection.externalPartyControlOverData._value}}
                            {%- endif %}
                            {{ macros.linkQuestion(equipmentCollection.externalPartyControlOverData._path) }}
                        {%- endif %}
                        {%- if equipmentCollection.externalPartyResponsibility._value -%}
                            {%- if equipmentCollection.externalPartyResponsibility._value == "embargo" %} 
                                The external party is responsible for long-term safekeeping and will publish it after a fixed embargo period.
                            {%- elif equipmentCollection.externalPartyResponsibility._value == "project_timeline" %} 
                                The external party is responsible for long-term safekeeping and will publish it according to the project timeline.
                            {%- elif equipmentCollection.externalPartyResponsibility._value == "delete" %} 
                                The external party is responsible for long-term safekeeping and will delete the data after it has been provided to the project partners and any necessary evaluations have been completed, while the project partners will be responsible for data publication.
                            {%- elif equipmentCollection.externalPartyResponsibility %} 
                                For the long-term responsibility of the data we have made following arrangements: {{equipmentCollection.externalPartyResponsibility._value}}
                            {%- endif %}
                            {{ macros.linkQuestion(equipmentCollection.externalPartyResponsibility._path) }}
                        {%- endif -%}
                    {%- endif -%}

                    {# --- Quality processes --- #}
                    {% set quality_labels = {
                    "calibration": "calibrating measures",
                    "repeatSamples": "conducting repeat samples or repeating measurements to monitor consistency",
                    "standardizedMethods": "using standardized methods for data capture and recording",
                    "dataEntryValidation": "performing data entry validation",
                    "dataPeerReview": "applying data peer review",
                    "usesControlledVocabularies": "using controlled vocabularies",
                    "knownOutcomeSamples": "measuring samples with known outcomes to monitor consistency"
                    } %}
                    {% set used = [] %}
                    {% for key, label in quality_labels.items() %}
                    {% if collection.equipmentCollection.qualityProcesses[key]
                        and collection.equipmentCollection.qualityProcesses[key]._value is sameas true %}
                        {% do used.append(label) %}
                    {% endif %}
                    {% endfor %}
                    {% if used | length > 0 %}
                    <p>
                        As part of this equipment-based collection, the following quality assurance procedures will be implemented:
                        {{ used | join(", ") }}{% if collection.equipmentCollection.qualityProcesses.otherQualityProcesses and collection.equipmentCollection.qualityProcesses.otherQualityProcesses._value %}, {{ collection.equipmentCollection.qualityProcesses.otherQualityProcesses._value }}{% endif %}.
                        {{ macros.linkQuestion(collection.equipmentCollection.usesQualityProcesses._path) }}
                    </p>
                    {%- endif -%}
                {% endif %}

                {# --- Non-equipment collection --- #}
                {% if collection.isNonEquipmentCollection._value is sameas true %}
                    {% set non = collection.nonEquipmentCollection %}
                    {% set methods = [] %}
                    {% if non.usesQuestionnaires._value %}{% do methods.append("questionnaires") %}{% endif %}
                    {% if non.usesReportsForms._value %}{% do methods.append("reports or forms") %}{% endif %}
                    {% if non.usesPatientRecords._value %}{% do methods.append("patient records") %}{% endif %}
                    {% if non.usesOtherForms._value %}{% do methods.append(non.usesOtherForms._value) %}{% endif %}

                    {% if methods | length > 0 %}
                    <p>This collection process relies on non-instrumental methods such as {{ methods | join(", ") }}.{{ macros.linkQuestion(collection.isNonEquipmentCollection._path) }}</p>
                    {% else %}
                    <p>This collection process relies on non-instrumental data capture, but no specific method has been indicated.{{ macros.linkQuestion(collection.isNonEquipmentCollection._path) }}</p>
                    {% endif %}
                {% endif %}

                {# --- Physical samples --- #}
                {% if collection.isPhysicalSamplesCollection._value is sameas true %}
                    <p>This collection process involves sampling and measuring from physical specimens.{{ macros.linkQuestion(collection.isPhysicalSamplesCollection._path) }}</p>
                {% endif %}

                {# --- Datasets resulting from this collection --- #}
                {% if collection.usedBy | length == data.dmp.datasets | length %}
                    <p>This collection process is used to generate all datasets within {{ globals.projects }}.</p>
                {%- else -%}
                    {% set datasets = [] %}
                    {% for datasetUuid in collection.usedBy %}
                    {% set ds = data.dmp.datasets | selectattr('uuid', 'equalto', datasetUuid) | first %}
                    {% if ds %}
                        {% if ds.name._raw %}
                        {% do datasets.append('<strong><a href="' ~ ds.name._raw.homepage ~ '" target="_blank">' ~ ds.name._raw.name ~ '</a></strong>' ~ macros.linkQuestion(ds.name._path)) %}
                        {% elif ds.name %}
                        {% do datasets.append('<strong>' ~ ds.name._value ~ '</strong>' ~ macros.linkQuestion(ds.name._path)) %}
                        {% else %}
                        {% do datasets.append("<strong>(no name)</strong>") %}
                        {% endif %}
                    {% endif %}
                    {% endfor %}
                    <p>As a result of this collection process, the following {{ datasetText }} will be generated within {{ globals.projects }}: {{ datasets | join(", ") | safe }}.</p>
                {% endif %}
                </li>
            {% endfor %}
        </ul>
        {%- endif -%}

        {# Provenance #}
        {%- if data.dmp.sharedResources.metadataSpecifications | length > 0 -%}
            {% if data.dmp.sharedResources.metadataSpecifications | length > 1 %}
                <p>To document the provenance of the generated data in our {{ globals.projects }}, several approaches will be employed:</p>
            {% elif data.dmp.sharedResources.metadataSpecifications | length == 1 %}
                <p>To document the provenance of the generated data in our {{ globals.projects }}, one approach will be employed:</p>
            {% endif %}
            <ul>
            {% for metadata in data.dmp.sharedResources.metadataSpecifications %}
                <li>
                {# Dataset using this provenance approach #}
                {% if metadata.usedBy | length == data.dmp.datasets | length %}
                    <p>Following provenance applies to all datasets generated within {{ globals.projects }}.</p>
                {% else %}
                    {% set datasets = [] %}
                    {% for datasetUuid in metadata.usedBy %}
                    {% set ds = data.dmp.datasets | selectattr('uuid', 'equalto', datasetUuid) | first %}
                    {% if ds %}
                        {% if ds.name._raw %}
                        {% do datasets.append('<strong><a href="' ~ ds.name._raw.homepage ~ '" target="_blank">' ~ ds.name._raw.name ~ '</a></strong>' ~ macros.linkQuestion(ds.name._path)) %}
                        {% elif ds.name %}
                        {% do datasets.append('<strong>' ~ ds.name._value ~ '</strong>' ~ macros.linkQuestion(ds.name._path)) %}
                        {% else %}
                        {% do datasets.append("<strong>(no name)</strong>") %}
                        {% endif %}
                    {% endif %}
                    {% endfor %}
                    <p>Following provenance applies to {{ datasets | join(", ") | safe }}.</p>
                {% endif %}
                <p>
                {%- if metadata.isProvenanceDocumented._value is sameas true -%}
                    {%- if metadata.provenanceDocumented.provenanceDocumentedType -%}
                        {%- if metadata.provenanceDocumented.provenanceDocumentedType._value == "lab_notebook" -%}
                            We will use lab notebooks to make sure that there is good provenance of the data analysis.
                        {%- elif metadata.provenanceDocumented.provenanceDocumentedType._value == "electronic_lab_notebook" -%}
                            We will use an electronic lab notebook to make sure that there is good provenance of the data analysis.
                        {%- elif metadata.provenanceDocumented.provenanceDocumentedType._value == "system" -%}
                            Our computing workflow system keeps provenance information to ensure the good provenance of the data analysis.
                        {%- elif metadata.provenanceDocumented.provenanceDocumentedType -%}
                            We will use other solution than (electronic) lab notebooks to make sure that there is good provenance of the data analysis{{ ": " ~ metadata.provenanceDocumented.provenanceDocumentedType._value }}
                        {%- endif -%}
                        {{ macros.linkQuestion(metadata.provenanceDocumented.provenanceDocumentedType._path) }}
                    {%- endif -%}

                    {%- if metadata.provenanceDocumented.usesStandard._value is sameas true -%}
                        {%- if metadata.provenanceDocumented.standardProvenanceUsed %}
                            For documenting the provenance, we will use the following standard: <em>{{ metadata.provenanceDocumented.standardProvenanceUsed._value }}</em>.{{ macros.linkQuestion(metadata.provenanceDocumented.standardProvenanceUsed._path) }}
                        {%- else %}
                            For documenting provenance we will use a standard (no specific standard has been provided).{{ macros.linkQuestion(metadata.provenanceDocumented.usesStandard._path) }}
                        {%- endif -%}

                    {%- elif metadata.provenanceDocumented.usesStandard._value is sameas false -%}
                        {%- if metadata.provenanceDocumented.noStandardReason._value == "no_standard" %}
                            For documenting provenance we will not use a standard because there is no standard in our {{globals.project}} area.{{ macros.linkQuestion(metadata.provenanceDocumented.noStandardReason._path) }}
                        {%- elif metadata.provenanceDocumented.noStandardReason._value %}
                            For documenting provenance we will not use a standard because: {{ metadata.provenanceDocumented.noStandardReason._value }}.{{ macros.linkQuestion(metadata.provenanceDocumented.noStandardReason._path) }}
                        {%- else %}
                            We will not use a standard for documenting provenance.{{ macros.linkQuestion(metadata.provenanceDocumented.usesStandard._path) }}
                        {%- endif -%}

                    {%- endif -%}

                {%- elif metadata.isProvenanceDocumented._value is sameas false -%}
                    Provenance is not documented{%- if metadata.noProvenanceReason %} because: {{ metadata.noProvenanceReason._value }}{{ macros.linkQuestion(metadata.noProvenanceReason._path) }}{%- else -%}.{{ macros.linkQuestion(metadata.isProvenanceDocumented._path) }}{%- endif -%}
                {%- endif -%}
                </p>
                </li>
            {% endfor %}
            </ul>

        {%- else -%}
            <p>No specification for documenting the provenance of the generated data has been defined.</p>
        {%- endif -%}

        {# Validating the integrity of the results #}
        {%- if data.dmp.sharedResources.processingEnvironments | length > 0 -%}
            {% if data.dmp.sharedResources.processingEnvironments | length > 1 %}
                <p>In our {{ globals.projects }}, several validation processes will be applied to ensure the integrity and reliability of the research results.</p>
            {% elif data.dmp.sharedResources.processingEnvironments | length == 1 %}
                <p>In our {{ globals.projects }}, a dedicated validation process will be applied to ensure the integrity and reliability of the research results.</p>
            {% endif %}
            <ul>
            {% for env in data.dmp.sharedResources.processingEnvironments %}
                <li>
                {% if env.isMonitoringIntegrityAfterProcessing._value is sameas true and env.monitoringIntegrityAfterProcessing | length > 0 %}
                    <p>
                        This validation of result integrity in processing environment will include
                        {{ env.monitoringIntegrityAfterProcessing | map(attribute='_label') | map('lower') | join(", ") }}.
                        {{ macros.linkQuestion(env.isMonitoringIntegrityAfterProcessing._path) }}
                    </p>
                {% else %}
                <p>No specific validation steps were defined for verifying the integrity of results.</p>
                {% endif %}
                </li>
            {% endfor %}
            </ul>

        {% else %}
        <p>No validation of data integrity is planned for the {{ globals.projects }}.</p>
        {% endif %}

    {% else %}
    <p>No datasets are expected to be generated in the {{ globals.projects }}.</p>
    {% endif %}

    {# Re-used datasets #}
    <h4>Re-used Datasets</h4>
    {%- if data.dmp.reusingData.hasPreexistingData._value is sameas true -%}
        <ul>
        {%- for consideredData in data.dmp.reusingData.consideredDatasets -%}
            <li>
            {%- if consideredData.name._raw -%}
                <strong><a href="{{ consideredData.name._raw.homepage }}" target="_blank">{{ consideredData.name._raw.name }}</a></strong>{{ macros.linkQuestion(consideredData.name._path) }}
            {%- elif consideredData.name._value -%}
                <strong>{{ consideredData.name._value }}{{ macros.linkQuestion(consideredData.name._path) }}</strong>
            {%- else -%}
                <strong>(no name given)</strong>
            {%- endif -%}
            {# Not Re-used datasets #}
            {%- if consideredData.isReused._value is sameas false -%}
                <p>We considered reusing this standard reference data
                {%- if consideredData.hasIdentifier._value is sameas true and consideredData.identifier %} available via: <a href="{{ consideredData.identifier._value }}" target="_blank">{{ consideredData.identifier._value }}</a>{{ macros.linkQuestion(consideredData.identifier._path) }}
                {%- else -%}.
                {%- endif -%}
                {%- if consideredData.noReusedReason._value -%}
                    {%- if consideredData.noReusedReason._value == "missesNeededData" -%}
                        <p>We decided not use this dataset because it misses the data we need.
                    {%- elif consideredData.noReusedReason._value == "missesRequiredAspects" -%}
                        <p>We decided not use this dataset because it misses required aspects.
                    {%- elif consideredData.noReusedReason._value == "missesQuality" -%}
                        <p>We decided not use this dataset because it is not sufficient quality.
                    {%- elif consideredData.noReusedReason._value == "insufficientConditionsForUse" -%}
                        <p>We decided not use this dataset because its conditions of use do not allow us to use it.
                    {%- elif consideredData.noReusedReason._value -%}
                        <p>We decided not use this dataset{% if consideredData.noReusedReason %}, because: {{ consideredData.noReusedReason._value }}{% endif %}.
                    {%- endif %}{{ macros.linkQuestion(consideredData.noReusedReason._path) }}</p>
                {%- else -%}
                    <p>We decided not use this reference dataset.</p>
                {%- endif -%}

            {%- elif consideredData.isReused._value is sameas true -%}
                {# Re-used datasets #}
                <p>We will re-use this standard reference data
                {%- if consideredData.hasIdentifier._value is sameas true and consideredData.identifier %}  available via: <a href="{{ consideredData.identifier._value }}" target="_blank">{{ consideredData.identifier._value }}</a>{{ macros.linkQuestion(consideredData.identifier._path) }}
                {%- endif -%}.</p>{{ macros.linkQuestion(consideredData.isReused._path) }}

                {# Data Use #}
                {%- if consideredData.isReused._value is sameas true and consideredData.reusedData -%}
                    {%- set reusedData = consideredData.reusedData -%}
                    {% if reusedData.purpose %}
                    <p>It is used in the {{ globals.projects }} for: {{ reusedData.purpose._value }}{{macros.linkQuestion(reusedData.purpose._path) }}</p>
                    {% endif %}
                    {# Reuse conditions #}
                    {%- if reusedData.conditions._value == "CC0" %}
                        <p>This data are freely available for any use.{{ macros.linkQuestion(reusedData.conditions._path) }}</p>
                    {%- elif reusedData.conditions._value == "CCBY" %}
                        <p>This data are freely available with obligation to quote the source.{{ macros.linkQuestion(reusedData.conditions._path) }}</p>
                    {%- elif reusedData.conditions._value == "exception" %}
                        <p>This data can be used based on legal copyright exceptions, without needing explicit permission.{{ macros.linkQuestion(reusedData.conditions._path) }}</p>
                    {%- elif reusedData.conditions %}
                        <p>This data can be used under the following conditions: {{ reusedData.conditions._value }}.{{ macros.linkQuestion(reusedData.conditions._path) }}</p>
                    {%- else %}
                        <p>Conditions for reusing this data are not given.</p>
                    {%- endif -%}

                    {# Maintainer #}
                    {%- if reusedData.maintainer._value -%}
                        <p>The maintainer of the data is {{ reusedData.maintainer._value }}.{{macros.linkQuestion(reusedData.maintainer._path) }}</p>
                    {%- endif -%}

                    {# Format #}
                    {%- if reusedData.isFormattingKnown._value is sameas true -%}
                        {%- if reusedData.formatting.formats -%}
                        <p>The data are available in the following {{ "format" if reusedData.formatting.formats|length == 1 else "formats" }}:  
                        {%- for format in reusedData.formatting.formats -%}
                            {%- if format._raw %} <em>{{format._raw.name }}</a></em>
                            {%- elif format._value %} <em>{{ format._value }}</em>
                            {%- endif -%}{{ macros.linkQuestion(format._path) }}{%- if not loop.last -%}, {%- endif -%}
                        {%- endfor -%}.
                        {%- endif -%}
                        {%- if reusedData.formatting.isUsableAsIs._value is sameas true -%}
                            <span> We can use this data directly, without any conversion.{{ macros.linkQuestion(reusedData.formatting.isUsableAsIs._path) }}</span>
                        {%- elif reusedData.formatting.isUsableAsIs._value is sameas false -%}
                            <span> We need to convert the data to a different format before we can use it.{{ macros.linkQuestion(reusedData.formatting.isUsableAsIs._path) }}</span>
                        {%- endif -%}
                        </p>
                    {%- elif reusedData.isFormattingKnown._value is sameas false -%}
                        <p>The format of the data is not known.{{ macros.linkQuestion(reusedData.isFormattingKnown._path) }}</p>
                    {%- endif -%}
                    {%- if reusedData.dataVolume -%}
                        <p>The approximate data volume is {{ reusedData.dataVolume._value }} GB.{{ macros.linkQuestion(reusedData.dataVolume._path) }}</p>
                    {%- endif -%}

                    {# Versioning #}
                    {%- if reusedData.isVersioned._value is sameas true -%}
                        <p>
                            The data are versioned
                            {%- if reusedData.versionStrategy.usedVersion %}, and we will use version {{ reusedData.versionStrategy.usedVersion._value }}.{{ macros.linkQuestion(reusedData.versionStrategy.usedVersion._path) }}{%- else -%}.{{ macros.linkQuestion(reusedData.isVersioned._path) }}{%- endif -%}
                            {%- if reusedData.versionStrategy.versioningProcess -%}
                                {%- if reusedData.versionStrategy.versioningProcess._value == "stay_with_old" %} If a new version becomes available, we will stay with the old version.
                                {%- elif reusedData.versionStrategy.versioningProcess._value == "new_analysis_done" %} If a new version becomes available, we will do new analyses with it.
                                {%- elif reusedData.versionStrategy.versioningProcess._value == "all_analysis_redone" %} If a new version becomes available, we will redo all analyses with it.
                                {%- elif reusedData.versionStrategy.versioningProcess._value == "depend_on_update" %} If a new version becomes available, we will evaluate whether to update our work based on the nature and significance of the changes.
                                {%- else %} {{ reusedData.versionStrategy.versioningProcess._value }}
                                {%- endif -%}
                                {{ macros.linkQuestion(reusedData.versionStrategy.versioningProcess._path) }}
                            {%- else -%}
                                We will not update the data to a new version, if new one becomes available.
                            {%- endif -%}
                        </p>
                    {%- elif reusedData.isVersioned._value is sameas false -%}
                        <p>This data are not versioned.{{ macros.linkQuestion(reusedData.isVersioned._path) }}</p>
                    {%- endif -%}

                    {# Data Reuser #}
                    {%- if reusedData.users|length > 0 -%}
                        <p>
                        {%- if reusedData.users|length == 1 -%}
                            There is only one user of the data within the {{ globals.projects }}: 
                        {%- elif reusedData.users|length > 1 -%}
                            There are several users of the data within the {{ globals.projects }}: 
                        {%- endif -%}
                        {%- if reusedData.users|length > 0 -%}
                            {%- for user in reusedData.users %} {{ user.name._value if user.name else "(no name given)" }}{{ macros.linkQuestion(user.name._path) }}
                                {%- if user.orcid %}
                                    ({{ macros.formatOrcid(user.orcid) }})
                                {%- endif -%}
                                {%- if not loop.last -%}, {% endif -%}
                            {%- endfor -%}.
                        {%- endif -%}
                        </p>
                    {%- endif -%}

                    {# Tools #}
                    {%- if reusedData.tools|length > 0 -%}
                        {%- if reusedData.tools|length == 1 -%}
                            <p>There is only one tool that will be needed to re-use the data:</p>
                        {%- else -%}
                            <p>There are {{ reusedData.tools|length }} tools that will be needed to re-use the data:</p>
                        {%- endif -%}
                        <ul>
                        {%- for tool in reusedData.tools -%}
                            <li>
                                <strong>{{ tool.name._value if tool.name._value else "(no name given)"}}</strong>{{ macros.linkQuestion(tool.name._path) }}
                                {%- if tool.description -%}
                                    : {{ tool.description._value }} {{ macros.linkQuestion(tool.description._path) }}
                                {%- endif -%}
                                {%- if tool.isFreeAndAvailable._value is sameas true %}
                                    <p>This tool is free and available for use.{{ macros.linkQuestion(tool.isFreeAndAvailable._path) }}</p>
                                {%- elif tool.isFreeAndAvailable._value is sameas false %}
                                    <p>This tool is not free or not generally available.{{ macros.linkQuestion(tool.isFreeAndAvailable._path) }}
                                    {%- if tool.noAvailableSolution._value %} An alternative solution is available to avoid using this tool: {{ tool.noAvailableSolution._value }}{{ macros.linkQuestion(tool.noAvailableSolution._path) }}
                                    {%- endif -%}
                                    </p>
                                {%- endif -%}
                                {%- if tool.hasAccessLink._value is sameas true and tool.accessLink %}
                                    <p>Access link: <a href="{{ tool.accessLink._value }}" target="_blank">{{ tool.accessLink._value }}</a>{{ macros.linkQuestion(tool.accessLink._path) }}</p>
                                {%- elif tool.hasAccessLink._value is sameas false and tool.noAccessLinkAlternatives -%}
                                    {%- if tool.noAccessLinkAlternatives.includesDocumentation._value is sameas true %}
                                        <p>Documentation is available for this tool.{{ macros.linkQuestion(tool.noAccessLinkAlternatives.includesDocumentation._path) }}</p>
                                    {%- elif tool.noAccessLinkAlternatives.includesDocumentation._value is sameas false and tool.noAccessLinkAlternatives.noDocumentationReason %}
                                        <p>No documentation is available because: {{ tool.noAccessLinkAlternatives.noDocumentationReason._value }}{{ macros.linkQuestion(tool.noAccessLinkAlternatives.noDocumentationReason._path) }}</p>
                                    {%- endif -%}
                                    {%- if tool.noAccessLinkAlternatives.includesSoftware._value is sameas true %}
                                        <p>The software itself (e.g. scripts) will be included within the dataset.{{ macros.linkQuestion(tool.noAccessLinkAlternatives.includesSoftware._path) }}</p>
                                    {%- elif tool.noAccessLinkAlternatives.includesSoftware._value is sameas false %}
                                        <p>The software itself (e.g. scripts) will not be included within the dataset.{{ macros.linkQuestion(tool.noAccessLinkAlternatives.includesSoftware._path) }}</p>
                                    {%- endif -%}
                                {%- endif -%}
                            </li>
                        {%- endfor -%}
                        </ul>
                    {%- endif -%}
                {%- endif -%}
            {%- endif -%}
            </li>
        {%- endfor -%}
        </ul>
    {%- else -%}
        <p>No pre-existing data will be re-used in this {{ globals.projects }}.</p>
    {%- endif -%}
    </div>
</div>
