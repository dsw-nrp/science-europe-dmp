<div id="q-what-data" class="question">
  <h3>2. What data (kind, format, volume) will be collected or produced?</h3>
  <div class="answer">

  {# Generated Datasets #}
    <h4>Generated Datasets</h4>
    {%- if data.dmp.datasets|length > 0 -%}
    The following dataset{{ "s" if data.dmp.datasets|length > 1 }} will be generated in {{globals.projects}}:
        <ul>
        {%- for dataset in data.dmp.datasets -%}
            <li>
            {%- if dataset.name -%}
                <strong>{{ dataset.name._value }}</strong>{{ macros.linkQuestion(dataset.name._path) }}
            {%- else -%}
                <strong>(no name given)</strong>
            {%- endif -%}
            {# Identifier #}
            {%- if dataset.identifiers|length > 0 %} (
                {%- for identifier in dataset.identifiers -%}
                    {{ macros.formatIdentifier(identifier) }}
                    {%- if not loop.last -%}, {% endif %}
                {%- endfor -%}
                )
            {%- endif %}:

            {# Type #}
            {%- if dataset.type -%}
                <p>This dataset is of type <em>{{ dataset.type._value }}</em>.{{macros.linkQuestion(dataset.type._path) }} </p>
            {%- else -%}
                <p>The type of this dataset is not specified.</p>
            {%- endif -%}

            {# Volume #}
            {%- set ns = namespace(total_volume=0, all_small=true) -%}
            {%- for distribution in dataset.distributions -%}
                {% if distribution.dataVolume.isLargeVolume._value is sameas true  %}
                    {% set ns.total_volume = ns.total_volume + distribution.dataVolume.largeVolume.estimatedVolume._value|float %}
                    {% set ns.all_small = false %}
                {% endif %}
            {% endfor %}

            {%- if dataset.distributions|length > 0 -%}
                {%- if ns.all_small is sameas true -%}
                <p>All distributions of this dataset are of small volume and do not pose any storage or processing problems.</p>
                {%- elif ns.total_volume > 0 -%}
                <p>The total estimated volume of all distributions for this dataset is approximately {{ (ns.total_volume | round(2)) }} GB.</p>
                {%- endif -%}
            {%- endif -%}
            </li>
        {%- endfor -%}
        </ul>
    {%- else -%}
        <p>No datasets will be generated in this {{ globals.projects }}.</p>
    {%- endif -%}

    {# Reusing Data #}
    {%- if data.dmp.reusingData.hasPreexistingData._value is sameas true -%}
        {%- if data.dmp.reusingData.consideredDatasets|length > 0 -%}
        <div>
            <h4>Re-used datasets</h4>
            <p>Datasets considered for reuse and actually reused are described in Section 1, Question 1.</p>
        </div>
        {%- endif -%}
    {%- endif -%}

    {# Format/Type with volume #}
    {%- set formats = [] -%}
    {%- set newDataTypes = [] -%}
    {%- set usedOntologies = [] -%}
    {%- for dataset in data.dmp.datasets -%}
        {%- for distribution in dataset.distributions -%}
            {# Collect formats #}
            {%- if distribution.formats -%}
                {%- for format in distribution.formats -%}
                    {%- if format.name._raw -%}
                        {%- set tmpFormat = format -%}
                        {%- do tmpFormat.name.update({
                                '_value': format.name._raw.name,
                                '_path': format.name._path,
                                '_raw': format.name._raw
                        }) -%}
                        {%- do formats.append(tmpFormat) -%}
                    {%- else -%}
                        {%- do formats.append(format) -%}
                    {%- endif -%}
                {%- endfor -%}
            {%- endif -%}
            {%- if distribution.newDataType -%}
                {%- set _ = newDataTypes.append({'newDataType': distribution.newDataType, 'distributionName': distribution.name}) -%}
            {%- endif -%}
            {%- for usedOntology in distribution.usedOntologies -%}
                {%- if usedOntology.name._raw -%}
                    {%- set tmpOntology = {} -%}
                    {%- do tmpOntology.update({
                        'name': {
                            '_value': usedOntology.name._raw.name,
                            '_path': usedOntology.name._path,
                            '_raw': usedOntology.name._raw
                        },
                        'url': {
                            '_value': usedOntology.name._raw.homepage,
                            '_path': usedOntology.name._path,
                            '_raw': usedOntology.name._raw
                        }
                    }) -%}
                    {%- do usedOntologies.append(tmpOntology) -%}
                {%- else -%}
                    {%- do usedOntologies.append(usedOntology) -%}
                {%- endif -%}
            {%- endfor -%}
        {%- endfor -%}
    {%- endfor -%}
    {# Remove duplicates based on .name._value for formats and used Ontologies #}
    {%- set formats = formats | unique(attribute='name._value') | list -%}
    {%- set usedOntologies = usedOntologies | unique(attribute='name._value') | list -%}
    
    {# Formats #}
    {%- if formats|length > 0 -%}
    <h4>Formats</h4>
    <div>We will be using the following data formats:
        <ul>
        {%- for format in formats -%}
        <li>
            {%- if format.name._raw %} <em><a href="https://fairsharing.org/{{ format.name._raw.id }}" target="_blank">{{format.name._raw.name }}</a></em>{{ macros.linkQuestion(format.name._path) }}
            {%- elif format.name._value %} <em>{{ format.name._value }}</em>{{ macros.linkQuestion(format.name._path) }}
            {%- else %} <em>(no name given)</em>
            {%- endif -%}
            <p>
            {# Well described? Standard?#}
            {%- if format.isDescribed or format.isStandard -%}
                This format is
                {%- if format.isDescribed._value is sameas true %}
                    well described{{ macros.linkQuestion(format.isDescribed._path) }}
                {%- elif format.isDescribed._value is sameas false %}
                    not well described{{ macros.linkQuestion(format.isDescribed._path) }}
                {%- endif -%}
                {%- if format.isStandard._value is sameas true %}
                    standard{{ macros.linkQuestion(format.isStandard._path) }}
                {%- elif format.isStandard._value is sameas false %}
                    {%- if format.noStandardReason._value == "no_format" %}
                        non-standard because there is no standardized format for this data type{{ macros.linkQuestion(format.noStandardReason._path) }}
                    {%- elif format.noStandardReason._value == "optimalization" %}
                        non-standard but it is optimized for processing speed and/or volume{{ macros.linkQuestion(format.noStandardReason._path) }}
                    {%- elif format.noStandardReason and format.noStandardReason._value %}
                        non-standard because: {{ format.noStandardReason._value }}{{ macros.linkQuestion(format.noStandardReason._path) }}
                    {%- else %}
                        non-standard{{ macros.linkQuestion(format.isStandard._path) }}
                    {%- endif %}
                {%- endif -%}
                .
            {%- endif -%}
            {# Suitable for long term? #}
            {%- if format.isSuitableForLongTerm._value is sameas true %}
                It is suitable for long-term preservation.{{ macros.linkQuestion(format.isSuitableForLongTerm._path) }}
            {%- elif format.isSuitableForLongTerm._value is sameas false %}
                It is not suitable for long-term preservation{{ macros.linkQuestion(format.isSuitableForLongTerm._path) }}
                {# Convert to suitable for long term? #}
                {%- if format.convertToLongTermSuitable._value is sameas true %}
                    and we will convert it to a format suitable for long-term preservation{{ macros.linkQuestion(format.convertToLongTermSuitable._path) }}
                {%- elif format.convertToLongTermSuitable._value is sameas false %}
                    but we will not convert it to a format suitable for long-term preservation{{ macros.linkQuestion(format.convertToLongTermSuitable._path) }}
                {%- endif -%}.
            {%- endif -%}
            </p>
        </li>
        {%- endfor -%}
        </ul>
    </div>
    {%- else -%}
    <div>We will not be using any specific data formats.</div>
    {%- endif -%}

    {# New data types #}
    {%- if newDataTypes|length > 0 -%}
    <h4>New Data Types</h4>
    <div>We will be using the following new types of data for listed distributions:
        <ul>
        {%- for newDataType in newDataTypes -%}
            <li>
                <em>{{ newDataType.distributionName._value if newDataType.distributionName._value else "(no name given)" }}</em>{{ macros.linkQuestion(newDataType.distributionName._path) }}
                {%- set usesOntology = newDataType.newDataType.usesNewOntology._value -%}
                {%- set providesMapping = newDataType.newDataType.providesOntologyMapping._value -%}
                <p>
                {# Ontology and mapping #}
                {%- if usesOntology is sameas false %}
                    Although we will be using new types of data in this distribution, suitable public controlled vocabularies or ontologies exist for those.{{ macros.linkQuestion(newDataType.newDataType.usesNewOntology._path) }}
                {%- elif usesOntology is sameas true and providesMapping is sameas true %}
                    We will be using new types of data in this distribution. For that reason, we will make and publish a vocabulary or ontology for some of our data.{{ macros.linkQuestion(newDataType.newDataType.usesNewOntology._path) }} Such terms will be mapped to existing vocabularies or ontologies.{{ macros.linkQuestion(newDataType.newDataType.providesOntologyMapping._path) }}
                {%- elif usesOntology is sameas true and providesMapping is sameas false %}
                    We will be using new types of data in this distribution. For that reason, we will make and publish a vocabulary or ontology for some of our data.{{ macros.linkQuestion(newDataType.newDataType.usesNewOntology._path) }} We will not provide mapping to existing vocabularies or ontologies.{{ macros.linkQuestion(newDataType.newDataType.providesOntologyMapping._path) }}
                {%- elif usesOntology is sameas true %}
                    We will be using new types of data in this distribution. For that reason, we will make and publish a vocabulary or ontology for some of our data.{{ macros.linkQuestion(newDataType.newDataType.usesNewOntology._path) }}
                {%- endif -%}
                {# Fields #}
                {%- if newDataType.newDataType.needsAddFields._value == "no" %}
                    We will not need to add any new fields to the data, all of them are already descried in a data type registry.{{ macros.linkQuestion(newDataType.newDataType.needsAddFields._path) }}
                {%- elif newDataType.newDataType.needsAddFields._value == "yes_existing_registry" %}
                    We will need to add new types to an existing data type registry.{{ macros.linkQuestion(newDataType.newDataType.needsAddFields._path) }}
                {%- elif newDataType.newDataType.needsAddFields._value == "yes_own_registry" %}
                    We will need to add new types to data type registry, that we will create on our own.{{ macros.linkQuestion(newDataType.newDataType.needsAddFields._path) }}
                {%- endif -%}
                {# Creation process #}
                {%- if newDataType.newDataType.creationProcess._value == "specification"%}
                    There is a closely related, more generic and open format that we can specialize for our needs.{{ macros.linkQuestion(newDataType.newDataType.creationProcess._path) }}
                {%- elif newDataType.newDataType.creationProcess._value == "linked_data_format" %}
                    There is a Linked Data Format that we can use to design our new data type.{{ macros.linkQuestion(newDataType.newDataType.creationProcess._path) }}
                {%- elif newDataType.newDataType.creationProcess._value == "custom" %}
                    We will create a completely new and custom data type format.{{ macros.linkQuestion(newDataType.newDataType.creationProcess._path) }}
                {%- endif -%}
                {# Description for others #}
                {%- if newDataType.newDataType.descriptionForOther._value is sameas true %}
                    We will provide a description of the new data type for others.{{ macros.linkQuestion(newDataType.newDataType.descriptionForOther._path) }}
                {%- endif -%}
                {# Data type registries #}
                {%- if newDataType.newDataType.dataTypeRegistry._value %}
                    We will use the following data type registries: {{ newDataType.newDataType.dataTypeRegistry._value }}.{{ macros.linkQuestion(newDataType.newDataType.dataTypeRegistry._path) }}
                {%- endif -%}
                </p>
            </li>
        {%- endfor -%}
        </ul>
    </div>
    {%- else -%}
    <div>We will not be using any new types of data.</div>
    {%- endif -%}
  </div>
</div>
