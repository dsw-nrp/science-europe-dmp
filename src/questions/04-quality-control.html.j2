<div id="q-how-data" class="question">
<h3>4. What data quality control measures will be used?</h3>

<div class="answer">
{% if data.dmp.datasets | length > 0 %}
    {%- if data.dmp.sharedResources.collections | length > 0 -%}
        {% if data.dmp.sharedResources.collections | length > 1 %}
            <p>In our {{ globals.projects }}, {{ data.dmp.sharedResources.collections | length }} distinct collection processes will be used to gather and generate research data:</p>
        {% elif data.dmp.sharedResources.collections | length == 1 %}
            <p>In our {{ globals.projects }}, a single collection process will be used to collect and generate research data:</p>
        {% endif %}
        <ul>
        {% for collection in data.dmp.sharedResources.collections %}
            <li style="margin-bottom: 2em;">

            {{ macros.datasetIntro(collection, "data quality control measures", data.dmp.datasets) }}
            {% set numDatasets = collection.usedBy | length %}

            {%- if collection.isEquipmentCollection._value is sameas true -%}
                {%- set quality_process_labels = {
                    "calibration": "calibrating measures",
                    "repeatSamples": " conducting repeat samples or repeating measurements to monitor the consistency of the results",
                    "standardizedMethods": "use standardized methods for data capture and recording",
                    "dataEntryValidation": "doing data entry validation",
                    "dataPeerReview": "using data peer review",
                    "usesControlledVocabularies": "using controlled vocabularies",
                    "knownOutcomeSamples": "measuring samples with known outcomes to monitor consistency",
                } -%}
                {%- set used_processes = [] -%}
                {%- for key, label in quality_process_labels.items() -%}
                    {%- if collection.equipmentCollection.qualityProcesses[key] and collection.equipmentCollection.qualityProcesses[key]._value is sameas true and label -%}
                    {%- do used_processes.append(label) -%}
                    {%- endif -%}
                {%- endfor -%}
                {%- if used_processes|length > 0 -%}
                    <p>During equipment collection of {{ datasetText }}, the following quality assurance processes will be used: 
                    {{ used_processes|join(", ") }}{% if collection.equipmentCollection.qualityProcesses.otherQualityProcesses and collection.equipmentCollection.qualityProcesses.otherQualityProcesses._value %}, {{ collection.equipmentCollection.qualityProcesses.otherQualityProcesses._value }}{% endif %}.{{ macros.linkQuestion(collection.equipmentCollection.usesQualityProcesses._path) }}
                    </p>
                {%- else -%}
                    <p>No specific quality assurance processes will be used during equipment collection of {{ datasetText }}.{{ macros.linkQuestion(collection.equipmentCollection.usesQualityProcesses._path) }}</p>
                {%- endif -%}
            {%- else -%}
                <p>During collection of non-equipment datasets ({{ datasetText }}), no quality assurance processes will be applied.</p>
            {%- endif -%}
            </li>
        {%- endfor -%}
    </ul>
    {%- else -%}
        <p>There is no description available for the datasets.</p>
    {%- endif -%}
{% else %}
    <p>There are no datasets described in this {{ globals.dmp }}.</p>
{% endif %}
</div>
