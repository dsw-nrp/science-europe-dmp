<div id="q-ethical-issues" class="question">
  <h3>9. What ethical issues and codes of conduct are there, and how will they be taken into account?</h3>

  <div class="answer">

  {%- if data.dmp.sharedResources.collections | length > 0 -%}
    {%- set ethicalCollections = [] -%}
    {%- for collection in data.dmp.sharedResources.collections -%}
      {%- if collection.isSubjectToEthicalReview._value is sameas true -%}
        {%- do ethicalCollections.append(collection) -%}
      {%- endif -%}
    {%- endfor -%}
    {%- if ethicalCollections | length > 0 -%}
      {%- set n = ethicalCollections | length -%}
      {%- if n > 1 -%}<ul>{%- endif -%}
      {%- for collection in ethicalCollections -%}
        {%- if n > 1 -%}<li style="margin-bottom: 2em;">{%- else -%}<div style="margin-bottom: 2em;">{%- endif -%}

        {{ macros.datasetIntro(collection, "ethical issues and codes of conduct", data.dmp.datasets) }}
        {% set numDatasets = collection.usedBy | length %}
        {%- set accessRestriction = collection.accessRestriction -%}

        {# Ethical Legislation #}
        {%- set ethicalReview = collection.ethicalReview -%}
        {%- if collection.isSubjectToEthicalReview and collection.isSubjectToEthicalReview._value is sameas true -%}
            <p>
            The data collection is subject to ethical review.{{ macros.linkQuestion(collection.isSubjectToEthicalReview._path) }}
            {%- if ethicalReview.ethicalCommitteeName or ethicalReview.ethicalCommitteeApprovalNumber -%}
                The ethical review is conducted by {{ ethicalReview.ethicalCommitteeName._value if ethicalReview.ethicalCommitteeName else "an ethics committee" }}{{ " (approval number: " ~ ethicalReview.ethicalCommitteeApprovalNumber._value ~ ")" if ethicalReview.ethicalCommitteeApprovalNumber else "" }}.{{ macros.linkQuestion(ethicalReview.ethicalCommitteeName._path) if ethicalReview.ethicalCommitteeName else "" }}{{ macros.linkQuestion(ethicalReview.ethicalCommitteeApprovalNumber._path) if ethicalReview.ethicalCommitteeApprovalNumber else "" }}
            {%- endif -%}
            {%- if ethicalReview.ethicalReviewLinkDocument or ethicalReview.ethicalReviewDocument %}
                The protocol from the meeting with the ethics committee is available
                {%- if ethicalReview.ethicalReviewLinkDocument %}
                    at: <a href="{{ ethicalReview.ethicalReviewLinkDocument._value }}" target="_blank">{{ ethicalReview.ethicalReviewLinkDocument._value }}</a>{{ macros.linkQuestion(ethicalReview.ethicalReviewLinkDocument._path) }}
                {%- endif -%}
                {%- if ethicalReview.ethicalReviewDocument %}
                    {%- if ethicalReview.ethicalReviewLinkDocument %} and can be downloaded {% else %} and can be downloaded {% endif %}
                    <a href="{{ ethicalReview.ethicalReviewDocument._url}}" target="_blank">here</a>{{ macros.linkQuestion(ethicalReview.ethicalReviewDocument._path) }}
                {%- endif -%}
                .
            {%- endif -%}
            {%- if ethicalReview.extensionOfReusedData._value == "not_applicable" %} 
                A new approval or extension of any existing approval under research ethics laws is not applicable for the re-use of the data.{{ macros.linkQuestion(ethicalReview.extensionOfReusedData._path) }}
            {%- elif ethicalReview.extensionOfReusedData._value == "existing"  %}
                An existing approval under research ethics laws covers our re-use of the data; no new approval or extension is required.{{ macros.linkQuestion(ethicalReview.extensionOfReusedData._path) }}
            {%- elif ethicalReview.extensionOfReusedData._value == "extension"  %}
                An extension of an existing approval under research ethics laws will be needed for the re-use of the data.{{ macros.linkQuestion(ethicalReview.extensionOfReusedData._path) }}
            {%- elif ethicalReview.extensionOfReusedData._value == "new"  %}
                A new ethical approval under research ethics laws will be needed to cover our usage of the data.{{ macros.linkQuestion(ethicalReview.extensionOfReusedData._path) }}
            {%- endif -%}
            </p>
        {%- elif collection.isSubjectToEthicalReview and collection.isSubjectToEthicalReview._value is sameas false -%}
            <p>The data collection is not subject to ethical legislation.{{ macros.linkQuestion(collection.isSubjectToEthicalReview._path) }}</p>
        {%- else -%}
            <p>No information on ethical aspects were provided.</p>
        {%- endif -%}
        {%- if n > 1 -%}</li>{%- else -%}</div>{%- endif -%}
      {%- endfor -%}
      {%- if n > 1 -%}</ul>{%- endif -%}
    {%- else -%}
      <p>There are no ethical issues or codes of conduct to report for the {{ globals.projects }}.</p>
    {%- endif -%}
  {%- else -%}
    <p>No shared resource collections have been defined for the {{ globals.projects }}. Therefore, there are no harmonised ethical issues or codes of conduct to report.</p>
  {%- endif -%}

  {# Policies in ethics and research integrity #}
  {%- set filtered_policies = [] -%}

  {%- for policyItem in data.dmp.policies -%}
    {%- set scope_labels = policyItem.scope | map(attribute='_label') | list -%}
    {%- if 'Ethics and Research Integrity' in scope_labels -%}
      {%- do filtered_policies.append(policyItem) -%}
    {%- endif -%}
  {%- endfor -%}

  {%- if filtered_policies | length > 0 -%}
  The following institutional, national, or funder policies and procedures relevant to ethics and research integrity are applicable to {{ globals.projects }}:
    <ul>
    {%- for policyItem in filtered_policies -%}
      <li>
        <strong>{{ policyItem.name._value | default("(no name)") }} </strong>
        {%- if policyItem.url -%} (<a href="{{ policyItem.url._value }}" target="_blank">{{ policyItem.url._value }}</a>){%- endif -%}{{ macros.linkQuestion(policyItem.name._path) }}<br>
        {%- if policyItem.description %}
          <em>{{ policyItem.description._value }}</em><br>
        {%- endif -%}
        Scope: {{ policyItem.scope | map(attribute='_label') | list | join(', ') }}
      </li>
    {%- endfor -%}
    </ul>
  {%- else -%}
    <p>There are no policies applicable to the scope of ethics and research integrity for the {{ globals.projects }}.</p>
  {%- endif -%}
  </div>
</div>
