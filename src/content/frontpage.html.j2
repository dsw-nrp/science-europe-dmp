<header>
  <p class="dmp"></p>
  <h1>
    {{ ctx.questionnaire.name }}
  </h1>
  <div class="dmp-info">
    <dl>
      {%- if data.dmp.collaboration.contributors|length > 0 -%}
        {%- set contacts = [] -%}
        {%- set creators = [] -%}
        {%- for i in data.dmp.collaboration.contributors -%}
          {%- if "Contact Person" in i.roles -%}
            {% do contacts.append(i)  %}
          {%- endif -%}
          {%- if "Creator of DMP" in i.roles -%}
            {% do creators.append(i)  %}
          {%- endif -%}
        {%- endfor -%}
        {%- set nContacts = contacts|length -%}
        <dt>Contact {{ "people" if (nContacts > 1) else "person" }}</dt>
        <dd>
          {%- if nContacts > 0 -%}
            <ul>
              {%- for i in contacts -%}
                <li>
                  {%- if i.name -%}
                    <span class="name"><strong>{{ i.name._value }}</strong>{{ macros.linkQuestion(i.name._path) }}</span>
                  {%- else -%}
                    <span class="name"><strong>(no name given)</strong></span>
                  {%- endif -%}
                  {{- " (" if i.email or i.orcid else "" -}}
                  {%- if i.email -%}
                      {{macros.formatEmail(i.email) }}{{ macros.linkQuestion(i.email._path) }}
                  {%- endif -%}
                  {{ ", " if i.email and i.orcid else "" }}
                  {%- if i.orcid -%}
                      {{ macros.formatOrcid(i.orcid) }}{{ macros.linkQuestion(i.orcid._path) }}
                  {%- endif -%}
                  {{- ") " if i.email or i.orcid else "" -}}
                  {%- if i.affiliation -%}
                      {%- if i.affiliation._raw-%}
                          {% for name in i.affiliation._raw.names -%}
                              {% if "ror_display" in name.types %}
                                  <br>Affiliation: <span class="affiliation"><a href="{{ i.affiliation._raw.id }}">{{ name.value }}</a></span>{{ macros.linkQuestion(i.affiliation._path) }}
                              {% endif %}
                          {%- endfor %}
                      {%- else -%}
                          <br>Affiliation: <span class="affiliation"> {{ i.affiliation._value }}</span>{{ macros.linkQuestion(i.affiliation._path) }}
                      {%- endif -%}
                  {%- endif -%}
                </li>
              {%- endfor -%}
            </ul>
          {%- else -%}
            <span class="empty-value">There is no contact person specified yet</span>
          {%- endif -%}
        </dd>
      {%- endif -%}

      <dt>Based on</dt>
      <dd>{{ ctx.package.name }}, {{ ctx.package.version }} (<span class="package-id"><span class="organization-id">{{ ctx.package.organizationId }}</span>:<span class="km-id">{{ ctx.package.kmId }}</span>:<span class="version">{{ ctx.package.version }}</span></span>)</dd>

      {%- if ctx.phaseUuid -%}
      <dt>Project phase</dt>
      <dd>{{ km.entities.phases[ctx.phaseUuid].title }}</dd>
      {%- endif -%}

      {%- set nCreators = creators|length -%}
      <dt>Created by</dt>
        <dd>
          {%- if nCreators > 0 -%}
            <ul>
                {%- for i in creators -%}
                  <li>
                    {%- if i.name -%}
                      <span class="name"><strong>{{ i.name._value }}</strong>{{ macros.linkQuestion(i.name._path) }}</span>
                    {%- else -%}
                      <span class="name"><strong>(no name given)</strong></span>
                    {%- endif -%}
                    {{- " (" if i.email or i.orcid else "" -}}
                    {%- if i.email -%}
                        {{macros.formatEmail(i.email) }}{{ macros.linkQuestion(i.email._path) }}
                    {%- endif -%}
                    {{ ", " if i.email and i.orcid else "" }}
                    {%- if i.orcid -%}
                        {{ macros.formatOrcid(i.orcid) }}{{ macros.linkQuestion(i.orcid._path) }}
                    {%- endif -%}
                    {{- ") " if i.email or i.orcid else "" -}}
                    {%- if i.affiliation -%}
                        {%- if i.affiliation._raw-%}
                            {% for name in i.affiliation._raw.names -%}
                                {% if "ror_display" in name.types %}
                                    <br>Affiliation: <span class="affiliation"><a href="{{ i.affiliation._raw.id }}">{{ name.value }}</a></span>{{ macros.linkQuestion(i.affiliation._path) }}
                                {% endif %}
                            {%- endfor %}
                        {%- else -%}
                            <br>Affiliation: <span class="affiliation"> {{ i.affiliation._value }}</span>{{ macros.linkQuestion(i.affiliation._path) }}
                        {%- endif -%}
                    {%- endif -%}
                  </li>
                {%- endfor -%}
              </ul>
            {%- else -%}
              <span class="empty-value">There is no creator specified yet</span>
          {%- endif -%}
        </dd>
      

      {% for version in ctx.questionnaire.versions if version.uuid == ctx.questionnaire.versionUuid %}
      <dt>Version</dt>
      <dd>{{version.name}} ({{ version.createdAt|datetime_format("%d %b %Y") }})</dd>
      {% endfor %}

      <dt>Generated on</dt>
      <dd>{{ ctx.document.createdAt|datetime_format("%d %b %Y") }}</dd>
    </dl>
    <p class="note">
      Data Management Plan created in {{ dc.config.service_name }} &laquo;<a href="{{ dc.config.service_url }}" target="_blank">{{ dc.config.service_domain_name }}</a>&raquo;
    </p>
  </div>
</header>
