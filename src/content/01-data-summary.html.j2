<div id="q-data-summary" class="question">
  <div class="answer">
  <p>This section provides an overview of the data that will be generated or reused in the project, including their types, formats, origin, expected volume, and potential utility.</p>
    <h4>Re-used Datasets</h4>
    {%- if data.dmp.reusingData.searchingProcess -%}
        <p>For the searching for existing data, we used the following process: {{ data.dmp.reusingData.searchingProcess._value }}{{macros.linkQuestion(data.dmp.reusingData.searchingProcess._path)}}</p>
    {%- endif -%}

    {%- if data.dmp.reusingData.hasPreexistingData._value is sameas true -%}
        <p>We have identified existing data that may be reused in this {{globals.projects}}.{%- if data.dmp.reusingData.consideredDatasets|length > 0 %} The following reference data have been considered for potential reuse:{%- endif -%}</p>
        <ul>
        {%- for consideredData in data.dmp.reusingData.consideredDatasets -%}
            <li>
                {%- if consideredData.name._raw -%}
                    <strong><a href="{{ consideredData.name._raw.homepage }}" target="_blank">{{ consideredData.name._raw.name }}</a></strong>{{ macros.linkQuestion(consideredData.name._path) }}
                {%- elif consideredData.name._value -%}
                    <strong>{{ consideredData.name._value }}{{ macros.linkQuestion(consideredData.name._path) }}</strong>
                {%- else -%}
                    <strong>(no name given)</strong>
                {%- endif -%}
                {%- if consideredData.hasIdentifier._value is sameas true and consideredData.identifier %}  (<a href="{{ consideredData.identifier._value }}" target="_blank">{{ consideredData.identifier._value }}</a>){{ macros.linkQuestion(consideredData.identifier._path) }}:
                {%- elif consideredData.hasIdentifier._value is sameas false and consideredData.noIdentifierReason -%}:
                    <p>No identifier available because: {{ consideredData.noIdentifierReason._value }}{{ macros.linkQuestion(consideredData.noIdentifierReason._path) }}</p>
                {%- else -%}:
                {%- endif -%}
                
                {# Data Use #}
                {%- if consideredData.isReused._value is sameas true and consideredData.reusedData -%}
                    {%- set reusedData = consideredData.reusedData -%}
                    <p>It is used in the project{{ macros.linkQuestion(consideredData.isReused._path) }}{% if reusedData.purpose %}, for: {{ reusedData.purpose._value }}{{macros.linkQuestion(reusedData.purpose._path)}}{% endif %}</p>
                    {# Reuse conditions #}
                    {%- if reusedData.conditions._value == "CC0" %}
                        <p>This data are freely available for any use.{{ macros.linkQuestion(reusedData.conditions._path) }}</p>
                    {%- elif reusedData.conditions._value == "CCBY" %}
                        <p>This data are freely available with obligation to quote the source.{{ macros.linkQuestion(reusedData.conditions._path) }}</p>
                    {%- elif reusedData.conditions._value == "exception" %}
                        <p>This data can be used based on legal copyright exceptions, without needing explicit permission.{{ macros.linkQuestion(reusedData.conditions._path) }}</p>
                    {%- elif reusedData.conditions %}
                        <p>This data can be used under the following conditions: {{ reusedData.conditions._value }}.{{ macros.linkQuestion(reusedData.conditions._path) }}</p>
                    {%- else %}
                        <p>Conditions for reusing this data are not given.</p>
                    {%- endif -%}

                    {# Maintainer #}
                    {%- if reusedData.maintainer._value -%}
                        <p>The maintainer of the data is {{ reusedData.maintainer._value }}.{{macros.linkQuestion(reusedData.maintainer._path) }}</p>
                    {%- endif -%}

                    {# Format #}
                    {%- if reusedData.isFormattingKnown._value is sameas true -%}
                        {%- if reusedData.formatting.formats -%}
                        <p>The data are available in the following {{ "format" if reusedData.formatting.formats|length == 1 else "formats" }}:  
                        {%- for format in reusedData.formatting.formats -%}
                            {%- if format._raw %} <em>{{format._raw.name }}</a></em>
                            {%- elif format._value %} <em>{{ format._value }}</em>
                            {%- endif -%}{{ macros.linkQuestion(format._path) }}{%- if not loop.last -%}, {%- endif -%}
                        {%- endfor -%}.
                        {%- endif -%}
                        {%- if reusedData.formatting.isUsableAsIs._value is sameas true -%}
                            <span> We can use this data directly, without any conversion.{{ macros.linkQuestion(reusedData.formatting.isUsableAsIs._path) }}</span>
                        {%- elif reusedData.formatting.isUsableAsIs._value is sameas false -%}
                            <span> We need to convert the data to a different format before we can use it.{{ macros.linkQuestion(reusedData.formatting.isUsableAsIs._path) }}</span>
                        {%- endif -%}
                        </p>
                    {%- elif reusedData.isFormattingKnown._value is sameas false -%}
                        <p>The format of the data is not known.{{ macros.linkQuestion(reusedData.isFormattingKnown._path) }}</p>
                    {%- endif -%}
                    {%- if reusedData.dataVolume -%}
                        <p>The approximate data volume is {{ reusedData.dataVolume._value }} GB.{{ macros.linkQuestion(reusedData.dataVolume._path) }}</p>
                    {%- endif -%}

                    {# Versioning #}
                    {%- if reusedData.isVersioned._value is sameas true -%}
                        <p>
                            The data are versioned
                            {%- if reusedData.versionStrategy.usedVersion %}, and we will use version {{ reusedData.versionStrategy.usedVersion._value }}.{{ macros.linkQuestion(reusedData.versionStrategy.usedVersion._path) }}{%- else -%}.{{ macros.linkQuestion(reusedData.isVersioned._path) }}{%- endif -%}
                            {%- if reusedData.versionStrategy.versioningProcess -%}
                                {%- if reusedData.versionStrategy.versioningProcess._value == "stay_with_old" %} If a new version becomes available, we will stay with the old version.
                                {%- elif reusedData.versionStrategy.versioningProcess._value == "new_analysis_done" %} If a new version becomes available, we will do new analyses with it.
                                {%- elif reusedData.versionStrategy.versioningProcess._value == "all_analysis_redone" %} If a new version becomes available, we will redo all analyses with it.
                                {%- elif reusedData.versionStrategy.versioningProcess._value == "depend_on_update" %} If a new version becomes available, we will evaluate whether to update our work based on the nature and significance of the changes.
                                {%- else %} {{ reusedData.versionStrategy.versioningProcess._value }}
                                {%- endif -%}
                                {{ macros.linkQuestion(reusedData.versionStrategy.versioningProcess._path) }}
                            {%- else -%}
                                We will not update the data to a new version, if new one becomes available.
                            {%- endif -%}
                        </p>
                    {%- elif reusedData.isVersioned._value is sameas false -%}
                        <p>This data are not versioned.{{ macros.linkQuestion(reusedData.isVersioned._path) }}</p>
                    {%- endif -%}

                    {# Data Reuser #}
                    {%- if reusedData.users|length > 0 -%}
                        <p>
                        {%- if reusedData.users|length == 1 -%}
                            There is only one user of the data within the project: 
                        {%- elif reusedData.users|length > 1 -%}
                            There are several users of the data within the project: 
                        {%- endif -%}
                        {%- if reusedData.users|length > 0 -%}
                            {%- for user in reusedData.users %} {{ user.name._value if user.name else "(no name given)" }}{{ macros.linkQuestion(user.name._path) }}
                                {%- if user.orcid %}
                                    ({{ macros.formatOrcid(user.orcid) }})
                                {%- endif -%}
                                {%- if not loop.last -%}, {% endif -%}
                            {%- endfor -%}.
                        {%- endif -%}
                        </p>
                    {%- endif -%}

                    {# Tools #}
                    {%- if reusedData.tools|length > 0 -%}
                        {%- if reusedData.tools|length == 1 -%}
                            <p>There is only one tool that will be needed to re-use the data:</p>
                        {%- else -%}
                            <p>There are {{ reusedData.tools|length }} tools that will be needed to re-use the data:</p>
                        {%- endif -%}
                        <ul>
                        {%- for tool in reusedData.tools -%}
                            <li>
                                <strong>{{ tool.name._value if tool.name._value else "(no name given)"}}</strong>{{ macros.linkQuestion(tool.name._path) }}
                                {%- if tool.description -%}
                                    : {{ tool.description._value }} {{ macros.linkQuestion(tool.description._path) }}
                                {%- endif -%}
                                {%- if tool.isFreeAndAvailable._value is sameas true %}
                                    <p>This tool is free and available for use.{{ macros.linkQuestion(tool.isFreeAndAvailable._path) }}</p>
                                {%- elif tool.isFreeAndAvailable._value is sameas false %}
                                    <p>This tool is not free or not generally available.{{ macros.linkQuestion(tool.isFreeAndAvailable._path) }}
                                    {%- if tool.noAvailableSolution._value %} An alternative solution is available to avoid using this tool: {{ tool.noAvailableSolution._value }}{{ macros.linkQuestion(tool.noAvailableSolution._path) }}
                                    {%- endif -%}
                                    </p>
                                {%- endif -%}
                                {%- if tool.hasAccessLink._value is sameas true and tool.accessLink %}
                                    <p>Access link: <a href="{{ tool.accessLink._value }}" target="_blank">{{ tool.accessLink._value }}</a>{{ macros.linkQuestion(tool.accessLink._path) }}</p>
                                {%- elif tool.hasAccessLink._value is sameas false and tool.noAccessLinkAlternatives -%}
                                    {%- if tool.noAccessLinkAlternatives.includesDocumentation._value is sameas true %}
                                        <p>Documentation is available for this tool.{{ macros.linkQuestion(tool.noAccessLinkAlternatives.includesDocumentation._path) }}</p>
                                    {%- elif tool.noAccessLinkAlternatives.includesDocumentation._value is sameas false and tool.noAccessLinkAlternatives.noDocumentationReason %}
                                        <p>No documentation is available because: {{ tool.noAccessLinkAlternatives.noDocumentationReason._value }}{{ macros.linkQuestion(tool.noAccessLinkAlternatives.noDocumentationReason._path) }}</p>
                                    {%- endif -%}
                                    {%- if tool.noAccessLinkAlternatives.includesSoftware._value is sameas true %}
                                        <p>The software itself (e.g. scripts) will be included within the dataset.{{ macros.linkQuestion(tool.noAccessLinkAlternatives.includesSoftware._path) }}</p>
                                    {%- elif tool.noAccessLinkAlternatives.includesSoftware._value is sameas false %}
                                        <p>The software itself (e.g. scripts) will not be included within the dataset.{{ macros.linkQuestion(tool.noAccessLinkAlternatives.includesSoftware._path) }}</p>
                                    {%- endif -%}
                                {%- endif -%}
                            </li>
                        {%- endfor -%}
                        </ul>
                    {%- endif -%}

                {%- elif consideredData.isReused._value is sameas false -%}
                    {%- if consideredData.noReusedReason._value -%}
                        {%- if consideredData.noReusedReason._value == "missesNeededData" -%}
                            <p>We decided not use this dataset because it misses the data we need.
                        {%- elif consideredData.noReusedReason._value == "missesRequiredAspects" -%}
                            <p>We decided not use this dataset because it misses required aspects.
                        {%- elif consideredData.noReusedReason._value == "missesQuality" -%}
                            <p>We decided not use this dataset because it is not sufficient quality.
                        {%- elif consideredData.noReusedReason._value == "insufficientConditionsForUse" -%}
                            <p>We decided not use this dataset because its conditions of use do not allow us to use it.
                        {%- elif consideredData.noReusedReason._value -%}
                            <p>We decided not use this dataset{% if consideredData.noReusedReason %}, because: {{ consideredData.noReusedReason._value }}{% endif %}.
                        {%- endif %}{{ macros.linkQuestion(consideredData.noReusedReason._path) }}</p>
                    {%- else -%}
                        <p>We decided not use this reference dataset.</p>
                    {%- endif -%}
                {%- endif -%}
            </li>
        {%- endfor -%}
        </ul>
    {%- elif data.dmp.reusingData.hasPreexistingData._value is sameas false-%}
        <p>We have not found any existing data that can be re-used for this project.{{ macros.linkQuestion(data.dmp.reusingData.hasPreexistingData._path) }}</p>
    {%- else -%}
        <p>We do not know whether we will re-use any existing data.</p>
    {%- endif -%}

    {# Generated Datasets #}
    <h4>Generated Datasets</h4>
    {%- if data.dmp.datasets|length > 0 -%}
    The following dataset{{ "s" if data.dmp.datasets|length > 1 }} will be generated in this {{globals.projects}}:
        <ul>
        {%- for dataset in data.dmp.datasets -%}
            <li>
            {%- if dataset.name._raw -%}
                <strong><a href="{{ dataset.name._raw.homepage }}" target="_blank">{{ dataset.name._raw.name }}</a></strong>{{ macros.linkQuestion(dataset.name._path) }}
            {%- elif dataset.name -%}
                <strong>{{ dataset.name._value }}</strong>{{ macros.linkQuestion(dataset.name._path) }}
            {%- else -%}
                <strong>(no name given)</strong>
            {%- endif -%}

            {# Identifier #}
            {%- if dataset.identifiers|length > 0 %} (
                {%- for identifier in dataset.identifiers -%}
                    {%- if identifier.type._raw and identifier.value._value-%}
                        <em><a href="{{ identifier.type._raw.homepage }}/{{identifier.value._value}}" target="_blank">{{ identifier.type._raw.homepage }}/{{identifier.value._value}}</a></em>{{ macros.linkQuestion(identifier.value._path) if identifier.value._path }}
                    {%- else -%}
                        <em>{{ identifier.type._value if identifier.type._value else "no type given" }}: {{ identifier.value._value if identifier.value else "no value given" }}</em>{{ macros.linkQuestion(identifier.value._path) if identifier.value._path }}
                    {%- endif -%}
                    {% if not loop.last %}, {% endif %}
                {%- endfor -%}
                )
            {%- endif %}:

            {# Purpose #}
            {%- if dataset.purposes|length > 0 -%}
                <p>
                    The purpose{{ "s" if dataset.purposes|length > 1 }} of this dataset {{"are" if dataset.purposes|length > 1 else "is" }}:
                    {%- for purpose in dataset.purposes -%}
                        {{ purpose._value }}{{ macros.linkQuestion(purpose._path) }}{% if not loop.last %}, {% endif %}
                    {%- endfor -%}
                </p>
            {%- else -%}
                <p>The purpose of this dataset is not specified.</p>
            {%- endif -%}

            {# Publication Status #}
            {% if dataset.isPublished._value is sameas true %}
                {% if dataset.partPublished._value -%}
                    <p>Only part of the dataset will be published: {{ dataset.partPublished._value }}{{ macros.linkQuestion(dataset.partPublished._path) }}</p>
                {%- else  -%}
                    <p>The entire dataset will be published.{{ macros.linkQuestion(dataset.isPublished._path) }}</p>
                {%- endif -%}
            {% elif dataset.isPublished._value is sameas false -%}
                <p>This dataset will not be published{% if dataset.noPublishedReason %}, because: {{ dataset.noPublishedReason._value }}{{ macros.linkQuestion(dataset.noPublishedReason._path) }}{%- else -%}.{{ macros.linkQuestion(dataset.isPublished._path) }}{% endif %}</p>
            {% endif %}

            {# Data Utility #}
            {%- if dataset.reuseRestriction -%}
                {%- if dataset.reuseRestriction.potentialDataUsers._value == "no" -%}
                    <p>This data are expected to be used only by us.{{ macros.linkQuestion(dataset.reuseRestriction.potentialDataUsers._path) }}</p>

                {%- elif dataset.reuseRestriction.potentialDataUsers._value == "same_domain" -%}
                    <p>Other researchers working in the same field of research could be interested in using this data.{{ macros.linkQuestion(dataset.reuseRestriction.potentialDataUsers._path) }}</p>

                {%- elif dataset.reuseRestriction.potentialDataUsers._value == "other_domain" -%}
                    <p>Researchers working in other fields of research could be interested in using this data.{{ macros.linkQuestion(dataset.reuseRestriction.potentialDataUsers._path) }} {% if  dataset.reuseRestriction.otherPotentialDataUsersUseCase -%}We think that other researchers can use this data as follows: {{ dataset.reuseRestriction.otherPotentialDataUsersUseCase._value}}{{ macros.linkQuestion(dataset.reuseRestriction.otherPotentialDataUsersUseCase._path) }}{% endif -%}</p>
                {%- endif -%}

            {%- endif -%}

            {# Collection Process #}
            {%- if dataset.collection -%}
                {# Measuring  #}
                {%- if dataset.collection.isEquipmentCollection._value is sameas true -%}
                    <p>This dataset will be collected using measuring equipment.{{ macros.linkQuestion(dataset.collection.isEquipmentCollection._path) }}</p>
                    {%- set equipmentCollection = dataset.collection.equipmentCollection -%}
                    {# Who will collect #}
                    {%- if equipmentCollection.whoMeasures._value == "experts_own_equipment" %}
                        This dataset will be collected by experts in the {{globals.projects}}, with our own equipment.{{ macros.linkQuestion(equipmentCollection.whoMeasures._path) }}
                    {%- elif equipmentCollection.whoMeasures._value == "experts_spec_infrastructure" %}
                        This dataset will be collected by experts in the {{globals.projects}}, at a specialized infrastructure.{{ macros.linkQuestion(equipmentCollection.whoMeasures._path) }}
                    {%- elif equipmentCollection.whoMeasures._value == "external_party" %}
                        This dataset will be collected by an external party{{ macros.linkQuestion(equipmentCollection.whoMeasures._path) }}
                        {%- if equipmentCollection.externalPartyControlOverData._value -%}
                            {%- if equipmentCollection.externalPartyControlOverData._value == "external_party" %} 
                                and they will also have control over the data.
                            {%- elif equipmentCollection.externalPartyControlOverData._value == "project_partners" -%} 
                                and the control over the data is equally shared between all project partners.
                            {%- elif equipmentCollection.externalPartyControlOverData %} 
                                and for the control over the data we have made following arrangements: {{equipmentCollection.externalPartyControlOverData._value}}
                            {%- endif %}
                            {{ macros.linkQuestion(equipmentCollection.externalPartyControlOverData._path) }}
                        {%- endif %}
                        {%- if equipmentCollection.externalPartyResponsibility._value -%}
                            {%- if equipmentCollection.externalPartyResponsibility._value == "embargo" %} 
                                The external party is responsible for long-term safekeeping and will publish it after a fixed embargo period.
                            {%- elif equipmentCollection.externalPartyResponsibility._value == "project_timeline" %} 
                                The external party is responsible for long-term safekeeping and will publish it according to the project timeline.
                            {%- elif equipmentCollection.externalPartyResponsibility._value == "delete" %} 
                                The external party is responsible for long-term safekeeping and will delete the data after it has been provided to the project partners and any necessary evaluations have been completed, while the project partners will be responsible for data publication.
                            {%- elif equipmentCollection.externalPartyResponsibility %} 
                                For the long-term responsibility of the data we have made following arrangements: {{equipmentCollection.externalPartyResponsibility._value}}
                            {%- endif %}
                            {{ macros.linkQuestion(equipmentCollection.externalPartyResponsibility._path) }}
                        {%- endif -%}
                    {%- endif -%}
                    </p>

                    {# Measuring equipment #}
                    {%- if equipmentCollection.instruments|length > 0 %}
                            <p>The following measuring equipment{{ "s" if equipmentCollection.instruments|length > 1 else "" }} will be used to collect the data in the {{globals.projects}}:</p>
                        <ul>
                        {% for instrument in equipmentCollection.instruments -%}
                            <li>
                                <strong>{{ instrument.name._value if instrument.name else "(no name given)" }}</strong>{{ macros.linkQuestion(instrument.name._path) }}
                                {%- if instrument.isStandard._value is sameas true %} 
                                    <br>The equipment is very well described and known.{{ macros.linkQuestion(instrument.isStandard._path) }}
                                {%- elif instrument.isStandard._value is sameas false %} 
                                    <br>The equipment is not fully described, so we will need to take extra care documenting the process.{{ macros.linkQuestion(instrument.isStandard._path) }}
                                {%- endif -%}
                                {%- if instrument.url %}
                                    <br>Available: <a href='{{ instrument.url._value }}' target='_blank'>{{ instrument.url._value }}</a>{{ macros.linkQuestion(instrument.url._path) }}
                                {%- endif %}
                                {%- if instrument.description %}
                                    <br>{{ instrument.description._value }}{{ macros.linkQuestion(instrument.description._path) }}
                                {%- endif %}
                            </li>
                        {%- endfor -%}
                        </ul>
                    {%- else -%}
                        <p>No measuring equipment is specified for this dataset.</p>
                    {%- endif -%}
                {%- endif -%}

                {# Non-Measuring Equipment Collection #}
                {%- if dataset.collection.isNonEquipmentCollection._value is sameas true -%}
                    {%- set nonEquipmentCollection = dataset.collection.nonEquipmentCollection -%}
                    {% set methods = [] %}
                    {% if nonEquipmentCollection.usesQuestionnaires._value is sameas true %}
                        {% do methods.append("questionnaires") %}
                    {% endif %}
                    {% if nonEquipmentCollection.usesReportsForms._value is sameas true %}
                        {% do methods.append("reports or forms") %}
                    {% endif %}
                    {% if nonEquipmentCollection.usesPatientRecords._value is sameas true  %}
                        {% do methods.append("patient records") %}
                    {% endif %}
                    {% if nonEquipmentCollection.usesOtherForms._value %}
                        {% do methods.append(nonEquipmentCollection.usesOtherForms._value) %}
                    {% endif %}
                    {% if methods|length > 0 %}
                        <p>This dataset will be captured using {{ methods|join(", ") }}.
                    {%- else -%}
                        <p>No specific capturing method is specified for this dataset.
                    {%- endif -%}
                    {{ macros.linkQuestion(dataset.collection.isNonEquipmentCollection._path) }}
                        </p>
                {%- endif -%}

                {# Physical Samples Collection #}
                {%- if dataset.collection.isPhysicalSamplesCollection._value is sameas true -%}
                    <p>This dataset will be collected from physical samples.{{ macros.linkQuestion(dataset.collection.isPhysicalSamplesCollection._path) }}</p>
                {%- endif -%}

            {%- else -%}
            <p>Collection process is not defined for this dataset.</p>
            {%- endif -%}

            {# Format & Type summary across distributions #}
            {%- set formatTypeSentences = [] -%}
            {%- set all_formats = [] -%}
            {%- set all_types = [] -%}
            {%- for distribution in dataset.distributions -%}
                {# Collect formats #}
                {%- if distribution.formats -%}
                    {%- for format in distribution.formats -%}
                        {%- if format.name._raw -%}
                            {%- set tmpFormat = format -%}
                            {%- do tmpFormat.name.update({
                                    '_value': format.name._raw.name,
                                    '_path': format.name._path,
                                    '_raw': format.name._raw
                            }) -%}
                            {%- do all_formats.append(tmpFormat) -%}
                        {%- else -%}
                            {%- do all_formats.append(format) -%}
                        {%- endif -%}
                    {%- endfor -%}
                {%- endif -%}
                {# Collect new data types #}
                {%- if distribution.usesNewDataType and distribution.usesNewDataType._value is sameas true and distribution.newDataType -%}
                    {%- set _ = all_types.append(distribution.newDataType) -%}
                {%- endif -%}
            {%- endfor -%}

            {# Formats #}
            {%- if all_formats|length > 0 -%}
                <p>The data will be available in the following {{ "format" if all_formats|length == 1 else "formats" }}:
                {%- for format in all_formats -%}
                    {%- if format.name._value %} <em>{{ format.name._value }}</em>{{ macros.linkQuestion(format.name._path) }}
                    {%- else %} <em>(no name given)</em>
                    {%- endif -%}
                    {%- set details = [] -%}
                    {%- if format.isStandard and format.isStandard._value is sameas true -%}
                        {%- do details.append("standard format") -%}
                    {%- elif format.isStandard and format.isStandard._value is sameas false -%}
                        {%- set reason = "not a standard format" -%}
                        {%- if format.noStandardReason and format.noStandardReason._value -%}
                        {%- set reason = reason ~ ": " ~ format.noStandardReason._value -%}
                        {%- endif -%}
                        {%- do details.append(reason) -%}
                    {%- endif -%}
                    {%- if format.isSuitableForLongTerm and format.isSuitableForLongTerm._value is sameas true -%}
                        {%- do details.append("suitable for long-term preservation") -%}
                    {%- elif format.isSuitableForLongTerm and format.isSuitableForLongTerm._value is sameas false -%}
                        {%- set longterm = "not suitable for long-term preservation" -%}
                        {%- if format.convertToLongTermSuitable and format.convertToLongTermSuitable._value is sameas true -%}
                        {%- set longterm = longterm ~ ", will be converted to format suitable for archiving" -%}
                        {%- endif -%}
                        {%- do details.append(longterm) -%}
                    {%- endif -%}
                    {%- if details|length > 0 %}
                        ({{ details|join("; ") }})
                    {%- endif -%}
                    {%- if not loop.last -%}, {%- endif -%}
                {% endfor %}.
                </p>
            {%- else -%}
                <p>The format of the data is not specified.</p>
            {%- endif -%}

            {# New Data Types #}
            {%- if all_types|length > 0 -%}
                <p>This dataset will use a new data type. There are more details about the new data types for each distribution of this dataset in the Section 2.3.</p>
            {%- endif -%}

            {# Volume #}
            {%- set ns = namespace(total_volume=0, all_small=true) -%}
            {%- for distribution in dataset.distributions -%}
                {% if distribution.dataVolume.isLargeVolume._value is sameas true  %}
                    {% set ns.total_volume = ns.total_volume + distribution.dataVolume.largeVolume.estimatedVolume._value|float %}
                    {% set ns.all_small = false %}
                {% endif %}
            {% endfor %}

            {%- if dataset.distributions|length > 0 -%}
                {%- if ns.all_small is sameas true -%}
                <p>All distributions of this dataset are of small volume and do not pose any storage or processing problems.</p>
                {%- elif ns.total_volume > 0 -%}
                <p>The total estimated volume of all distributions for this dataset is approximately {{ (ns.total_volume | round(2)) }} GB.</p>
                {%- endif -%}
            {%- endif -%}
            </li>
        {%- endfor -%}
        </ul>
    {%- else -%}
        <p>We do not plan to generate any data in this project.</p>
    {%- endif -%}
    </div>
</div>
