<div id="q-required-resources" class="question">
  <h3>15. What resources (for example financial and time) will be dedicated to data management and ensuring that data will be FAIR (Findable, Accessible, Interoperable, Re-usable)?</h3>

  <div class="answer">
    {# Costs #}
    <ul>
    {%- for project in data.dmp.projects -%}
      {%- if project.costs|length > 0 -%}
      <li>
        <strong>
          {%- if project.name -%}
            {{project.name._value if project.name._value else "(no name given)"}}{{ macros.linkQuestion(project.name._path) }}
            {%- else -%}
            <em>(no name given)</em>
          {%- endif -%}
        </strong>:
        <p>Following resources will be dedicated to data management and ensuring that data will be FAIR:</p>
        <ul>
          {%- for cost in project.costs -%}
            <li>
                <p><b>
                {%- if cost.title -%}
                  {{ cost.title._value if cost.title._value else "(no name given)" }}{{ macros.linkQuestion(cost.title._path) }}:
                {%- else -%}
                  <em>(no name given):</em>
                {%- endif -%}
                </b>
                {%- if cost.amount -%}
                &nbsp;{{ cost.amount._value if cost.amount._value else "(no amount given)" }}{{ macros.linkQuestion(cost.amount._path) }}
                  {%- if cost.currency._raw %}
                      {{ cost.currency._raw.code }}{{ macros.linkQuestion(cost.currency._path) }}
                  {%- elif cost.currency %}
                      {{ cost.currency._value if cost.currency._value else "(no currency given)" }}{{ macros.linkQuestion(cost.currency._path) }}
                  {%- else %}
                      (no currency given)
                  {%- endif -%}
                {%- else -%}
                  (no amount given)
                {%- endif %}
                {%- if cost.allocation|length > 0 -%}
                  <br>This will be used for: 
                    {{ cost.allocation | join(", ") }}.
                {%- endif %}

              {# How cost will be covered #}
              {%- if cost.isCoveredByGrant or cost.coveredBy -%}
                {%- if cost.isCoveredByGrant._value is sameas true -%}
                    <br>This cost will be covered by funding from grant<em>
                    {{ cost.coveredBy._label if cost.coveredBy._label else "(no grant given)" }}
                    {%- if cost.coveredBy._label -%}
                      {{ macros.linkQuestion(cost.coveredBy._path) }}
                    {%- else -%}
                      {{ macros.linkQuestion(cost.isCoveredByGrant._path) }}
                    {%- endif -%}.</em>
                {%- elif cost.isCoveredByGrant._value is sameas false and cost.coveredBy -%}
                  <br>This cost will be covered by <em>{{cost.coveredBy._value if cost.coveredBy._value else "(no coverage given)" }}</em>.{{ macros.linkQuestion(cost.coveredBy._path) }}
                {%- endif %}
              {%- endif %}
              </p>
            </li>
          {%- endfor %}
        </ul>
      </li>
      {%- endif -%}
    {%- endfor -%}
    </ul>
  
    {# Additional expertise #}
    {%- set collaboration = data.dmp.collaboration -%}
    {%- if collaboration.expertiseRequirement -%}
      {%- if collaboration.expertiseRequirement._value == "no" -%}
        <p>To execute the DMP, no additional specialist expertise is required.{{ macros.linkQuestion(collaboration.expertiseRequirement._path) }}</p>
      {%- elif collaboration.expertiseRequirement._value == "trainedStaffAvailable" -%}
        <p>To execute the DMP, additional specialist expertise is required and we have such trained support staff available.{{ macros.linkQuestion(collaboration.expertiseRequirement._path) }}</p>
      {%- elif collaboration.expertiseRequirement._value == "trainingExistingStaff" -%}
        <p>
          To execute the DMP, additional specialist expertise is required. We will be training existing staff
          {%- if collaboration.trainingDetails %}
            in: {{ collaboration.trainingDetails._value|dot }}{{ macros.linkQuestion(collaboration.trainingDetails._path) }}
          {%- else -%}.{{ macros.linkQuestion(collaboration.expertiseRequirement._path) }}
          {%- endif -%}
        </p>
      {%- elif collaboration.expertiseRequirement._value == "hiringNewStaff" -%}
        <p>
          To execute the DMP, additional specialist expertise is required. We will be hiring new people with additional expertise
          {%- if collaboration.expertiseDetails %}
            in: {{ collaboration.expertiseDetails._value|dot }}{{ macros.linkQuestion(collaboration.expertiseDetails._path) }}
          {%- else -%}.{{ macros.linkQuestion(collaboration.expertiseRequirement._path) }}
          {%- endif -%}
        </p>
      {%- endif -%}
    {%- endif -%}

    {# Additional tools/software #}
    {%- set unavailableToolsUnique = [] -%}
    {%- set toolNames = [] -%}
    {%- for tool in data.dmp.sharedResources.tools -%}
      {%- if tool.isAvailableInInstitution and tool.isAvailableInInstitution._value is sameas false and tool.name and tool.name._value not in toolNames -%}
        {%- do unavailableToolsUnique.append(tool) -%}
        {%- do toolNames.append(tool.name._value) -%}
      {%- endif -%}
    {%- endfor -%}
    {%- if unavailableToolsUnique|length > 0 -%}
      <p>We require the following tool or software in addition to what is usually available in the institute: <em>{{ unavailableToolsUnique|map(attribute='name._value')|join(', ') }}</em>.</p>
    {%- else -%}
      <p>We do not require any hardware or software in addition to what is usually available in the institute.</p>
    {%- endif -%}

  {# Archiving (Cold storage) #}

  <p>Section 5, Question 11 describes how data will be archived and preserved for the long term, including funding sources and minimum retention periods for each dataset.</p>
  </div>
</div>
