<div id="q-accessible" class="question">
  <div class="answer">
   {%- if data.dmp.datasets|length > 0 -%}
        <p>This section outlines how data will be made accessible to others, including details about repositories used, access protocols, possible restrictions, and conditions under which access will be granted.</p>
        {%- for dataset in data.dmp.datasets -%}
            <h4>
                {%- if dataset.name._raw -%}
                    <strong><a href="{{ dataset.name._raw.homepage }}" target="_blank">{{ dataset.name._raw.name }}</a></strong>{{ macros.linkQuestion(dataset.name._path) }}
                {%- elif dataset.name -%}
                    <strong>{{ dataset.name._value }}</strong>{{ macros.linkQuestion(dataset.name._path) }}
                {%- else -%}
                    <strong>(no name given)</strong>
                {%- endif -%}
                {# If will be published #}
                {%- if dataset.isPublished._value is sameas true %} (published){{ macros.linkQuestion(dataset.isPublished._path) }}
                {%- elif dataset.isPublished._value is sameas false %} (not published){{ macros.linkQuestion(dataset.isPublished._path) }}
                {%- endif -%}:
            </h4>

            {%- if dataset.reuseRestriction -%}
                {%- set accessRestriction = dataset.reuseRestriction.accessRestriction -%}
                {# Ownership #}
                {%- if accessRestriction.dataRightsArrangement._value -%}
                    <p>
                    {%- if accessRestriction.dataRightsArrangement._value == "no_copyrightable" -%}
                        Our data is legally not copyrightable, there is no rightsholder.
                    {%- elif accessRestriction.dataRightsArrangement._value == "principal_investigator" -%}
                        The Principal Investigator is the rightsholder of all data.
                    {%- elif accessRestriction.dataRightsArrangement._value == "institute" -%}
                        The institute is the rightsholder of all data.
                    {%- elif accessRestriction.dataRightsArrangement._value == "intellectual_property" -%}
                        We have a consortium agreement that arranges Intellectual Property.
                    {%- elif accessRestriction.dataRightsArrangement._value -%}
                        We have made the following arrangements regarding the data rightsholder: {{ accessRestriction.dataRightsArrangement._value }}
                    {%- endif -%}
                    {{ macros.linkQuestion(accessRestriction.dataRightsArrangement._path) }}</p>
                {%- endif -%}

                {# Open philosophy  #}
                {%- if accessRestriction.asOpenAsPossibleApproach._value is sameas true -%}
                    <p>We will be working with the philosophy <em>as open as possible</em> for this dataset.{{ macros.linkQuestion(accessRestriction.asOpenAsPossibleApproach._path) }}</p>
                {%- endif -%}

                {# Can open data #}
                {%- if accessRestriction.canDataOpen._value is sameas true -%}
                    <p>This dataset can become completely open over time.{{ macros.linkQuestion(accessRestriction.canDataOpen._path) }}</p>
                {%- elif accessRestriction.canDataOpen._value is sameas false -%}
                    {%- set dataCannotOpen = accessRestriction.dataCannotOpen -%}
                    {%- set legalReasons = dataCannotOpen.isLegalReason._value -%}
                    {%- set businessReasons = dataCannotOpen.isBusinessReason._value -%}
                    {%- set otherReasons = dataCannotOpen.isOtherReason._value -%}
                    {%- set anyReason = legalReasons or businessReasons or otherReasons -%}
                    {%- set nReasons = [legalReasons, businessReasons, otherReasons]|select('equalto', true)|list|length -%}
                    {%- if anyReason -%}
                        <p>
                        This dataset cannot become completely open because 
                        {%- if nReasons == 1 -%}
                            {%- if legalReasons %}
                                {%- set privacy = dataCannotOpen.legalReason.isPrivacyReason._value -%}
                                {%- set ip = dataCannotOpen.legalReason.isIntellectualPropertyReason._value -%}
                                {%- set nLegal = [privacy, ip]|select('equalto', true)|list|length -%}
                                {%- if nLegal == 1 -%}
                                    {%- if privacy %}
                                        of privacy reasons.{{ macros.linkQuestion(dataCannotOpen.legalReason.isPrivacyReason._path) }}
                                    {%- elif ip %}
                                        of intellectual property reasons.{{ macros.linkQuestion(dataCannotOpen.legalReason.isIntellectualPropertyReason._path) }}
                                    {%- endif -%}
                                {%- elif nLegal > 1 %}
                                    of privacy{{ macros.linkQuestion(dataCannotOpen.legalReason.isPrivacyReason._path) }} and intellectual property reasons.{{ macros.linkQuestion(dataCannotOpen.legalReason.isIntellectualPropertyReason._path) }}
                                {%- else %}
                                    of legal reasons.{{ macros.linkQuestion(dataCannotOpen.isLegalReason._path) }}
                                {%- endif -%}
                            {%- elif businessReasons -%}
                                {%- if dataCannotOpen.businessReason == "patents" %}
                                    of patent-related business reasons.{{ macros.linkQuestion(dataCannotOpen.isBusinessReason._path) }}
                                {%- else %}
                                    of business reasons{{  ": " ~ dataCannotOpen.businessReason._value if dataCannotOpen.businessReason else "." }}{{ macros.linkQuestion(dataCannotOpen.isBusinessReason._path) }}
                                {%- endif -%}
                            {%- elif otherReasons %}
                                {%- if dataCannotOpen.otherReason == "papers" %}
                                    we want to publish a paper first.{{ macros.linkQuestion(dataCannotOpen.isOtherReason._path) }}
                                {%- else %}
                                    we have other reasons{{ ": " ~ dataCannotOpen.otherReason._value if dataCannotOpen.otherReason else "." }}{{ macros.linkQuestion(dataCannotOpen.isOtherReason._path) }}
                                {%- endif -%}
                            {%- endif -%}
                        {%- else %} of:
                        <ul>
                            {%- if legalReasons %}
                                {%- set privacy = dataCannotOpen.legalReason.isPrivacyReason._value -%}
                                {%- set ip = dataCannotOpen.legalReason.isIntellectualPropertyReason._value -%}
                                {%- set nLegal = [privacy, ip]|select('equalto', true)|list|length -%}
                                {%- if nLegal == 1 -%}
                                    {%- if privacy -%}
                                        <li>privacy reasons{{ macros.linkQuestion(dataCannotOpen.legalReason.isPrivacyReason._path) }}</li>
                                    {%- elif ip -%}
                                        <li>intellectual property reasons{{ macros.linkQuestion(dataCannotOpen.legalReason.isIntellectualPropertyReason._path) }}</li>
                                    {%- endif -%}
                                {%- elif nLegal > 1 -%}
                                    <li>privacy{{ macros.linkQuestion(dataCannotOpen.legalReason.isPrivacyReason._path) }} and intellectual property reasons{{ macros.linkQuestion(dataCannotOpen.legalReason.isIntellectualPropertyReason._path) }}</li>
                                {%- else -%}
                                    <li>legal reasons{{ macros.linkQuestion(dataCannotOpen.isLegalReason._path) }}</li>
                                {%- endif -%}
                            {%- endif -%}
                            {%- if businessReasons %}
                                {%- if dataCannotOpen.businessReason == "patents" -%}
                                    <li>patent-related business reasons{{ macros.linkQuestion(dataCannotOpen.isBusinessReason._path) }}</li>
                                {%- else -%}
                                    <li>business reasons{{  ": " ~ dataCannotOpen.businessReason._value if dataCannotOpen.businessReason else "" }}{{ macros.linkQuestion(dataCannotOpen.isBusinessReason._path) }}</li>
                                {%- endif -%}
                            {%- endif -%}
                            {%- if otherReasons -%}
                                {%- if dataCannotOpen.otherReason == "papers" -%}
                                    <li>we want to publish a paper first{{ macros.linkQuestion(dataCannotOpen.isOtherReason._path) }}</li>
                                {%- else -%}
                                    <li>other reasons{{ ": " ~ dataCannotOpen.otherReason._value if dataCannotOpen.otherReason else "" }}{{ macros.linkQuestion(dataCannotOpen.isOtherReason._path) }}</li>
                                {%- endif -%}
                            {%- endif -%}
                        </ul>
                        {%- endif -%}
                        </p>
                    {%- endif -%}

                    {# Data Access #}
                    {%- if dataCannotOpen.isAccessProcessDefined._value is sameas true -%}
                        <p>
                            {%- set accessProcess = dataCannotOpen.accessProcess -%}
                        The data access process is defined{% if accessProcess.description %} as follows: {{ accessProcess.description._value }}{{ macros.linkQuestion(dataCannotOpen.accessProcess.description._path) }}{% else -%}.{{ macros.linkQuestion(dataCannotOpen.isAccessProcessDefined._path) }}{% endif %}
                            {%- if accessProcess.timeFrame._value %}
                                The process will take place within {{ accessProcess.timeFrame._value }}.{{ macros.linkQuestion(dataCannotOpen.accessProcess.timeFrame._path) }}
                            {%- endif -%}
                            {%- if accessProcess.isExpectedCost._value is sameas true and accessProcess.expectedCost._value %}
                                The process will incur costs associated with accessing and using the data, which are expected to be {{ accessProcess.expectedCost._value }} 
                                {%- if accessProcess.currency._raw %}
                                    {{ accessProcess.currency._raw.code }}
                                {%- elif accessProcess.currency._value %}
                                    {{ accessProcess.currency._value }}
                                {%- else %}
                                    (no currency given)
                                {%- endif -%}
                                .{{ macros.linkQuestion(dataCannotOpen.accessProcess.expectedCost._path) }}
                            {%- elif accessProcess.isExpectedCost._value is sameas true %}
                                The process will incur costs associated with accessing and using the data.{{ macros.linkQuestion(dataCannotOpen.accessProcess.isExpectedCost._path) }}
                            {%- endif -%}
                        </p>
                    {%- endif -%}
                    {%- if dataCannotOpen.collaboratorAccessProcess -%}
                        <p>
                            For collaborators within the {{globals.projects}}, the access process is defined as follows: {{ dataCannotOpen.collaboratorAccessProcess._value }}.{{ macros.linkQuestion(dataCannotOpen.collaboratorAccessProcess._path) }}
                        </p>
                    {%- endif -%}

                    {%- if legalReasons -%}
                        {%- if dataCannotOpen.legalReason.isAuthenticatedAccess._value is sameas true -%}
                            <p>
                            Concerning the legal reasons, an authenticated access will be required.{{ macros.linkQuestion(dataCannotOpen.legalReason.isAuthenticatedAccess._path) }}
                            {%- if dataCannotOpen.legalReason.authenticatedAccess.authenticationProcess -%}
                                {%- if dataCannotOpen.legalReason.authenticatedAccess.authenticationProcess._value == "username_password" %}
                                    Username and password will be used for authentication.
                                {%- elif dataCannotOpen.legalReason.authenticatedAccess.authenticationProcess._value == "sso" %}
                                    Single Sign-On (SSO) will be used for authentication.
                                {%- elif dataCannotOpen.legalReason.authenticatedAccess.authenticationProcess %}
                                    Other authentication process will be used: {{ dataCannotOpen.legalReason.authenticatedAccess.authenticationProcess._value }}.
                                {%- endif -%}
                                {{ macros.linkQuestion(dataCannotOpen.legalReason.authenticatedAccess.authenticationProcess._path) }}
                            {%- endif -%}
                            {%- if dataCannotOpen.legalReason.authenticatedAccess.whoAuthenticate._value -%}
                                {%- if dataCannotOpen.legalReason.authenticatedAccess.whoAuthenticate._value == "project_member" %}
                                    People can apply to one of the project members.
                                {%- elif dataCannotOpen.legalReason.authenticatedAccess.whoAuthenticate._value == "new_data_access_committe" %}
                                    People can apply to the data access committee that we will set up.
                                {%- elif dataCannotOpen.legalReason.authenticatedAccess.whoAuthenticate._value == "existing_data_access_committe" %}
                                    People can apply to {{ "the <em>" ~ dataCannotOpen.legalReason.authenticatedAccess.whoAuthenticate.dataAccessCommitte._value ~ "</em>" if dataCannotOpen.legalReason.authenticatedAccess.whoAuthenticate.dataAccessCommitte else "existing" }} data access committee.
                                {%- elif dataCannotOpen.legalReason.authenticatedAccess.whoAuthenticateOther %}
                                    For the authorization of potential users, we will make special arrangements{{ ": " ~ dataCannotOpen.legalReason.authenticatedAccess.whoAuthenticateOther._value if dataCannotOpen.legalReason.authenticatedAccess.whoAuthenticateOther  else "." }}
                                {%- endif -%}
                                {{ macros.linkQuestion(dataCannotOpen.legalReason.authenticatedAccess.whoAuthenticate._path) }}
                            {%- endif -%}
                            {%- if dataCannotOpen.legalReason.authenticatedAccess.authenticationCriteriaAvailable._value is sameas true %}
                                The criteria for authentication will be openly available.{{ macros.linkQuestion(dataCannotOpen.legalReason.authenticatedAccess.authenticationCriteriaAvailable._path) }}
                            {%- endif -%}
                            </p>
                        {%- endif -%}
                    {%- endif -%}

                    {# Data Sharing Agreement #}
                    {%- if dataCannotOpen.isDataSharingAgreementRequired._value is sameas true -%}
                        {%- set dataSharingAgreement = dataCannotOpen.dataSharingAgreement -%}
                        <p>A data sharing agreement will be required for accessing the data{{ macros.linkQuestion(dataCannotOpen.isDataSharingAgreementRequired._path) }}
                        {%- if dataSharingAgreement.isDefined._value is sameas true %}
                            (already defined){{ macros.linkQuestion(dataSharingAgreement.isDefined._path) }}
                        {%- elif dataSharingAgreement.isDefined._value is sameas false  %}
                            (not yet defined){{ macros.linkQuestion(dataSharingAgreement.isDefined._path) }}
                        {%- endif -%}.
                        {%- if dataSharingAgreement.documentLink._value and dataSharingAgreement.document %}
                            The data sharing agreement can be accessed at {{ dataSharingAgreement.documentLink._value }}{{ macros.linkQuestion(dataSharingAgreement.documentLink._path) }} or you can download it: {{ macros.downloadUrlFile(dataSharingAgreement.document) }}.{{ macros.linkQuestion(dataSharingAgreement.document._path) }}
                        {%- elif dataSharingAgreement.documentLink._value %}
                            The data sharing agreement can be accessed at {{ dataSharingAgreement.documentLink._value }}.{{ macros.linkQuestion(dataSharingAgreement.documentLink._path) }}
                        {%- elif dataSharingAgreement.document %}
                            You can download the data sharing agreement here: {{ macros.downloadUrlFile(dataSharingAgreement.document) }}.{{ macros.linkQuestion(dataSharingAgreement.document._path) }}
                        {%- endif -%}
                        {%- if dataSharingAgreement.description._value %}
                            Summary of the Data Sharing Agreement: {{ dataSharingAgreement.description._value }}.{{ macros.linkQuestion(dataSharingAgreement.description._path) }}
                        {%- endif -%}
                        </p>
                    {%- elif dataCannotOpen.isDataSharingAgreementRequired._value is sameas false -%}
                        <p>A data sharing agreement will not be required for accessing the data.{{ macros.linkQuestion(dataCannotOpen.isDataSharingAgreementRequired._path) }}</p>
                    {%- endif -%}
                {%- endif -%}

                {# Publishing metadata/documentation  #}
                <p>
                {%- if accessRestriction.isMetadataAvailable._value is sameas true -%}
                    Metadata will be openly available for this dataset{{ macros.linkQuestion(accessRestriction.isMetadataAvailable._path) }}
                    {%- if dataset.metadata -%}
                        {%- if dataset.metadata.isLicenseCC0._value is sameas true %}
                            (under the CC0 license){{ macros.linkQuestion(dataset.metadata.isLicenseCC0._path) }}
                        {%- elif dataset.metadata.isLicenseCC0._value is sameas false -%}
                            {%- if dataset.metadata.noLicenseCC0Reason._value %} (not under the CC0 license, because: {{ dataset.metadata.noLicenseCC0Reason._value }}){{ macros.linkQuestion(dataset.metadata.noLicenseCC0Reason._path) }}
                            {%- else %} (not under the CC0 license){{ macros.linkQuestion(dataset.metadata.isLicenseCC0._path) }}{%- endif -%}
                        {%- endif -%}
                        {%- if dataset.metadata.isStandardMetadata._value is sameas true %} in a standard form that can be harvested and indexed{{ macros.linkQuestion(dataset.metadata.isStandardMetadata._path) }}
                        {%- elif dataset.metadata.isStandardMetadata._value is sameas false -%}
                            {%- if dataset.metadata.noStandardMetadata.canBeHarvestedIndexed._value is sameas true %} in a non-standard form{{ macros.linkQuestion(dataset.metadata.isStandardMetadata._path)}} that can be harvested and indexed{{ macros.linkQuestion(dataset.metadata.noStandardMetadata.canBeHarvestedIndexed._path) }}
                            {%- elif dataset.metadata.noStandardMetadata.canBeHarvestedIndexed._value is sameas false %} in a non-standard form{{ macros.linkQuestion(dataset.metadata.isStandardMetadata._path)}} that cannot be harvested and indexed{{ macros.linkQuestion(dataset.metadata.noStandardMetadata.canBeHarvestedIndexed._path) }}
                            {%- endif -%}
                        {%- endif -%}.
                        {%- if dataset.metadata.isAvailableAfterDataNotAvailable._value is sameas true %}
                            Metadata will be available even after the data is no longer available{{ macros.linkQuestion(dataset.metadata.isAvailableAfterDataNotAvailable._path) }}
                            {%- if dataset.metadata.howAvailableGuaranteed._value %}
                            (we will do the following: {{ dataset.metadata.howAvailableGuaranteed._value }}){{ macros.linkQuestion(dataset.metadata.howAvailableGuaranteed._path) }}
                            {%- endif -%}
                        {%- elif dataset.metadata.isAvailableAfterDataNotAvailable._value is sameas false %}
                            Metadata will not be available after the data is no longer available{{ macros.linkQuestion(dataset.metadata.isAvailableAfterDataNotAvailable._path) }}
                            {%- if dataset.metadata.noAvailableReason._value %}
                                (because: {{ dataset.metadata.noAvailableReason._value }}){{ macros.linkQuestion(dataset.metadata.noAvailableReason._path) }}
                            {%- endif -%}
                        {%- endif -%}
                    {%- endif -%}.
                {%- elif accessRestriction.isMetadataAvailable._value is sameas false -%}
                    Metadata will not be available for this dataset{{ macros.linkQuestion(accessRestriction.isMetadataAvailable._path) }}
                    {%- if accessRestriction.isMetadataAvailable.noMetadataAvailableReason._value %} because: {{ accessRestriction.isMetadataAvailable.noMetadataAvailableReason._value }}.{{ macros.linkQuestion(accessRestriction.isMetadataAvailable.noMetadataAvailableReason._path) }}
                    {%- endif -%}.
                {%- endif -%}
                {%- if accessRestriction.isDocumentationAvailable._value is sameas true %}
                    Documentation will be openly available for this dataset.{{ macros.linkQuestion(accessRestriction.isDocumentationAvailable._path) }}
                {%- elif accessRestriction.isDocumentationAvailable._value is sameas false %}
                    Documentation will not be available for this dataset{{ macros.linkQuestion(accessRestriction.isDocumentationAvailable._path) }}
                    {%- if accessRestriction.isDocumentationAvailable.noDocumentationAvailableReason %} because: {{ accessRestriction.isDocumentationAvailable.noDocumentationAvailableReason._value }}.{{ macros.linkQuestion(accessRestriction.isDocumentationAvailable.noDocumentationAvailableReason._path) }}
                    {%- endif -%}.
                {%- endif -%}
                </p>
            {%- endif -%}

            {# Distributions #}
            {%- if dataset.distributions|length > 0 -%}
                <p>This dataset has {{ dataset.distributions|length }} distribution{{ 's' if dataset.distributions|length != 1 else '' }}:
                <ul>
                {%- for distribution in dataset.distributions -%}
                    <li>
                        {%- if distribution.name -%}
                            <strong>{{ distribution.name._value }}</strong>{{ macros.linkQuestion(distribution.name._path) }}
                        {%- else -%}
                            <strong>(no distribution name given)</strong>
                        {%- endif -%}
                        <p>
                        {%- if distribution.dataStorage -%}
                            {# Repository access #}
                            This distribution will be accessible through the repository {% if distribution.dataStorage.type|length > 0 -%}(
                                {%- for type in distribution.dataStorage.type -%}
                                    {{ type._label|lower }}{{ ", " if not loop.last else "" }}
                                {%- endfor -%}) {% endif %}
                            <em>
                                {%- if distribution.dataStorage.name -%}
                                    {{ distribution.dataStorage.name._value }}{{ macros.linkQuestion(distribution.dataStorage.name._path) }}
                                {%- else -%}
                                    (no name given)
                                {%- endif -%}
                            </em>
                            {%- if distribution.dataStorage.url %}
                                (<a href="{{ distribution.dataStorage.url._value }}" target="_blank">{{ distribution.dataStorage.url._value }}</a>){{ macros.linkQuestion(distribution.dataStorage.url._path) }}
                            {%- endif -%}.
                            Details on datasets persistent identifiers and who provides them can be found in the Section 2.1.

                            {# Certification #}
                            {%- if distribution.dataStorage.storage.isCertified or distribution.dataStorage.storage.supportsVersioning  -%}
                                The repository
                                {% if distribution.dataStorage.storage.isCertified._value is sameas true %}
                                    is certified{{ macros.linkQuestion(distribution.dataStorage.storage.certification._path) }}{% if distribution.dataStorage.storage.certification %} ({{ distribution.dataStorage.storage.certification._label }}){{ macros.linkQuestion(distribution.dataStorage.storage.certification._path) }}{% endif %}
                                {% elif distribution.dataStorage.storage.isCertified._value is sameas false %}
                                    is not certified{{ macros.linkQuestion(distribution.dataStorage.storage.certification._path) }}
                                {% endif %}

                                {%- if distribution.dataStorage.storage.isCertified and distribution.dataStorage.storage.supportsVersioning %} and{% else %}.{% endif %}

                                {# Versioning #}
                                {% if distribution.dataStorage.storage.supportsVersioning._value is sameas true %}
                                    supports versioning of the data.{{ macros.linkQuestion(distribution.dataStorage.storage.supportsVersioning._path) }}
                                {% elif distribution.dataStorage.storage.supportsVersioning._value is sameas false %}
                                    does not support versioning of the data.{{ macros.linkQuestion(distribution.dataStorage.storage.supportsVersioning._path) }}
                                {% endif %}
                            {%- endif -%}

                            {# PID systems #}
                            {% if distribution.dataStorage.storage.pidSystems|length > 0 %}
                                It uses the following persistent identifier system{% if distribution.dataStorage.storage.pidSystems|length > 1 %}s{% endif %}: {{ macros.linkQuestion(distribution.dataStorage.storage.pidSystems[0]._path) }}
                                <em>
                                {%- for pidSystemItem in distribution.dataStorage.storage.pidSystems -%}
                                    {%- if pidSystemItem.pidSystem._raw -%}
                                        {{ pidSystemItem.pidSystem._raw.name  }} - {{ pidSystemItem.pidSystem._raw.homepage }}
                                    {%- else -%}
                                        {{ pidSystemItem.pidSystem._value }}
                                    {%- endif -%}
                                    {{ ", " if not loop.last else "" }}
                                {%- endfor -%}
                                </em>
                                {# Resolvable PID #}
                                {% if distribution.dataStorage.storage.resolvablePid._value is sameas true %}
                                    with resolvable persistent identifiers.{{ macros.linkQuestion(distribution.dataStorage.storage.resolvablePid._path) }}
                                {% elif distribution.dataStorage.storage.resolvablePid._value is sameas false %}
                                    but does not use resolvable persistent identifiers.{{ macros.linkQuestion(distribution.dataStorage.storage.resolvablePid._path) }}
                                {% endif %}
                            {% else %}
                                {% if distribution.dataStorage.storage.resolvablePid._value is sameas true %}
                                    It supports resolvable persistent identifiers.{{ macros.linkQuestion(distribution.dataStorage.storage.resolvablePid._path) }}
                                {% elif distribution.dataStorage.storage.resolvablePid._value is sameas false %}
                                    It does not support resolvable persistent identifiers.{{ macros.linkQuestion(distribution.dataStorage.storage.resolvablePid._path) }}
                                {% endif %}
                            {% endif %}

                            {# Repository requirements #}
                            {%- if distribution.dataStorage.agreementOnStorageInfrastructureUse._value -%}
                                Accessing and using the hosting infrastructure may require following steps and agreements: {{ distribution.dataStorage.agreementOnStorageInfrastructureUse._value }}.{{ macros.linkQuestion(distribution.dataStorage.agreementOnStorageInfrastructureUse._path) }}
                            {%- endif -%}

                        {%- else -%}
                            No repository specified for this distribution.
                        {%- endif -%}
                        </p>
                    
                        {# Licenses #}
                        <p>
                        {%- if distribution.isLicenseAssignedForDistribution._value is sameas true -%}
                            {%- if distribution.licensing.isLicenseChosen._value is sameas true and distribution.licensing.licenses|length > 0 -%}
                                The distribution will be available under the following {{ "licenses" if licensesItems|length > 1 else "license" }}:
                                <ul>
                                {%- for license in distribution.licensing.licenses -%}
                                    <li>
                                        {%- if license.license._raw -%}
                                            <strong>{{ license.license._raw.name }}</strong>{{ macros.linkQuestion(license.license._path) }}
                                        {%- elif license.license -%}
                                            <strong>{{ license.license._value }}</strong>{{ macros.linkQuestion(license.license._path) }}
                                        {%- else -%}
                                            <strong>(no name given):</strong>
                                        {%- endif -%}
                                        {%- if license.startDate -%}
                                            <br>Start date: {{ license.startDate._value }}{{ macros.linkQuestion(license.startDate._path) }}
                                        {%- endif -%}
                                    </li>
                                {%- endfor -%}
                                </ul>

                            {%- elif distribution.licensing.isLicenseChosen._value is sameas false %}
                                No license has been selected for this distribution yet.{{ macros.linkQuestion(distribution.licensing.isLicenseChosen._path) }}
                                {%- if distribution.licensing.notYetDecidedLicense -%}
                                    {%- if distribution.licensing.notYetDecidedLicense.isOpenLicense._value is sameas true %}
                                        We intend to use an open license for this distribution.{{ macros.linkQuestion(distribution.licensing.notYetDecidedLicense.isOpenLicense._path) }}
                                        {%- if distribution.licensing.notYetDecidedLicense.licenseBasedOnLicenseSelector %}
                                            We have used the License Selector tool to help us decide, and as a result, we are considering the following license: {{ distribution.licensing.notYetDecidedLicense.licenseBasedOnLicenseSelector._value }}.{{ macros.linkQuestion(distribution.licensing.notYetDecidedLicense.licenseBasedOnLicenseSelector._path) }}
                                        {%- endif -%}
                                    {%- elif distribution.licensing.notYetDecidedLicense.isOpenLicense._value is sameas false %}
                                        We do not plan to use an open license for this distribution{{ macros.linkQuestion(distribution.licensing.notYetDecidedLicense._path) }} {%- if distribution.licensing.notYetDecidedLicense.noOpenLicenseReason %} because: {{ distribution.licensing.notYetDecidedLicense.noOpenLicenseReason._value }}{{ macros.linkQuestion(distribution.licensing.notYetDecidedLicense.noOpenLicenseReason._path) }}{%- endif -%}
                                    {%- endif -%}
                                {%- endif -%}
                            {%- else -%}
                                We plan to assign a license to this distribution, but it has not been specified yet.{{ macros.linkQuestion(distribution.licensing.isLicenseChosen._path) }}
                            {%- endif -%}
                        {%- elif distribution.isLicenseAssignedForDistribution._value is sameas false -%}
                            No license specified for this distribution.{{ macros.linkQuestion(distribution.isLicenseAssignedForDistribution._path) }}
                        {%- endif -%}
                        </p>
                        {# Free and Standard Protocol #}
                        {%- if distribution.technicalAvailability -%}
                            {%- set technicalAvailability = distribution.technicalAvailability -%}
                            {%- if technicalAvailability.isAccessibleViaStandardProtocol._value is sameas true -%}
                                <p>This distribution will be accessible via a standard protocol{{ macros.linkQuestion(technicalAvailability.isAccessibleViaStandardProtocol._path) }}
                                {%- if technicalAvailability.usedStandardProtocol._value %} ({{ technicalAvailability.usedStandardProtocol._value }}){{ macros.linkQuestion(technicalAvailability.usedStandardProtocol._path) }}
                                {%- endif -%}.</p>
                            {%- elif technicalAvailability.isAccessibleViaStandardProtocol._value is sameas false -%}
                                <p>This distribution will not be accessible via a standard protocol{{ macros.linkQuestion(technicalAvailability.isAccessibleViaStandardProtocol._path) }}
                                {%- if technicalAvailability.notAccessibleViaStandardProtocolReason._value %} because: {{ technicalAvailability.notAccessibleViaStandardProtocolReason._value }}{{ macros.linkQuestion(technicalAvailability.notAccessibleViaStandardProtocolReason._path) }}{%- endif -%}.</p>
                            {%- endif -%}
                        {%- endif -%}

                        {# When published? #}
                        {%- if distribution.whenAvailable -%}
                            <p>
                            {%- if distribution.whenAvailable.isAvailableImmediately._value is sameas true %}
                                This distribution will be published as soon as possible after collecting it.{{ macros.linkQuestion(distribution.whenAvailable.isAvailableImmediately._path) }}
                            {%- elif distribution.whenAvailable.isAvailableImmediately._value is sameas false -%}
                                {%- set postponedAvailability = distribution.whenAvailable.postponedAvailability %}
                                This distribution will not be available immediately after collection.{{ macros.linkQuestion(distribution.whenAvailable.isAvailableImmediately._path) }}
                                {%- if postponedAvailability.isExactStartDateKnown._value is sameas true and postponedAvailability.exactStartDate._value %}
                                    It will be available starting from {{ postponedAvailability.exactStartDate._value }}.{{ macros.linkQuestion(postponedAvailability.exactStartDate._path) }}
                                {%- elif postponedAvailability.isExactStartDateKnown._value is sameas false and postponedAvailability.availabilityDelayAfterProjectEnd._value %}
                                    It will be available {{ postponedAvailability.availabilityDelayAfterProjectEnd._value }} after the end of the project.{{ macros.linkQuestion(postponedAvailability.availabilityDelayAfterProjectEnd._path) }}
                                {%- endif -%}
                                {%- if postponedAvailability.isEmbargoPeriod._value is sameas true %}
                                    There will be an embargo period{{ macros.linkQuestion(postponedAvailability.isEmbargoPeriod._path) }}
                                        {%- if postponedAvailability.embargoPeriod.durationEmbargoPeriod._value %}
                                            of {{ postponedAvailability.embargoPeriod.durationEmbargoPeriod._value }}{{ macros.linkQuestion(postponedAvailability.embargoPeriod.durationEmbargoPeriod._path) }}
                                        {%- endif -%}
                                        {%- if postponedAvailability.embargoPeriod.reason._value %}
                                            (reason: {{ postponedAvailability.embargoPeriod.reason._value }}){{ macros.linkQuestion(postponedAvailability.embargoPeriod.reason._path) }}
                                        {%- endif -%}.
                                {%- elif postponedAvailability.isEmbargoPeriod._value is sameas false and postponedAvailability.noEmbargoReasonForPostponedAvailability._value %}
                                    There is no embargo period; the postponed availability is due to: {{ postponedAvailability.noEmbargoReasonForPostponedAvailability._value }}{{ macros.linkQuestion(postponedAvailability.noEmbargoReasonForPostponedAvailability._path) }}.
                                {%- endif -%}
                            {%- else %}
                                The availability date for this distribution has not been specified.
                            {%- endif -%}
                            </p>
                        {%- endif -%}
                    </li>
                {%- endfor -%}
                </ul>
            {%- endif -%}

            {# Software/Tools #}
            {%- if data.dmp.areSpecialToolsRequired._value is sameas true -%}
                {%- if dataset.tools|length > 0 -%}
                    <p>A user of this data need specific software to be able to use it:
                    <ul>
                    {%- for tool in dataset.tools -%}
                        <li><strong>{{ tool.name._value if tool.name._value else "(no name given)" }}</strong>{{ macros.linkQuestion(tool.name._path) }}
                        <br>{{tool.description._value if tool.description._value else "(no description given)"}}{{ macros.linkQuestion(tool.description._path) }}<br>
                        {%- if tool.isFreeAndAvailable._value is sameas true %}
                            This tool is free and available for use.{{ macros.linkQuestion(tool.isFreeAndAvailable._path) }}
                        {%- elif tool.isFreeAndAvailable._value is sameas false %}
                            This tool is not free and available for use.{{ macros.linkQuestion(tool.isFreeAndAvailable._path) }}
                            {%- if tool.noAvailableSolution %}
                                However, there is an alternative solution that allows omitting this tool: {{tool.noAvailableSolution._value}}{{ macros.linkQuestion(tool.noAvailableSolution._path) }}
                            {%- endif -%}
                        {%- endif -%}
                        {%- if tool.hasAccessLink._value is sameas true and tool.accessLink %}
                            This tool can be accessed at {{tool.accessLink._value}}{{ macros.linkQuestion(tool.accessLink._path) }}
                        {%- elif tool.hasAccessLink._value is sameas false %}
                            This tool cannot be accessed directly, but it can be obtained through other means.{{ macros.linkQuestion(tool.hasAccessLink._path) }}
                            {%- if tool.noAccessLinkAlternatives.includesDocumentation._value is sameas true %}
                                The documentation of this software will be included in the metadata of data set.{{ macros.linkQuestion(tool.noAccessLinkAlternatives.includesDocumentation._path) }}
                            {%- elif tool.noAccessLinkAlternatives.includesDocumentation._value is sameas false %}
                                The documentation of this software will not be included in the metadata of this data set{{" because: " ~ tool.noAccessLinkAlternatives.noDocumentationReason._value if tool.noAccessLinkAlternatives.noDocumentationReason else '.'}}{{ macros.linkQuestion(tool.noAccessLinkAlternatives.includesDocumentation._path) }}
                            {%- endif -%}
                            {%- if tool.noAccessLinkAlternatives.includesSoftware._value is sameas true %}
                                The software (e.g. in open source code) will be included.{{ macros.linkQuestion(tool.noAccessLinkAlternatives.includesSoftware._path) }}
                            {%- elif tool.noAccessLinkAlternatives.includesSoftware._value is sameas false %}
                                The software (e.g. in open source code) will not be included.{{ macros.linkQuestion(tool.noAccessLinkAlternatives.includesSoftware._path) }}
                            {%- endif -%}
                        {%- endif -%}
                        </li>
                    {%- endfor -%}
                    </ul>
                    </p>
                {%- else -%}
                    A user of this data can use it without any specific software.{{ macros.linkQuestion(data.dmp.areSpecialToolsRequired._path) }}
                {%- endif -%}
            {%- elif data.dmp.areSpecialToolsRequired._value is sameas false -%}
                A user of any of the datasets can use it without any specific software{{ " because: " ~ data.dmp.noSpecialToolsReason._value if data.dmp.noSpecialToolsReason._value else "." }}{{ macros.linkQuestion(data.dmp.areSpecialToolsRequired._path) }}
            {%- endif -%}
        {%- endfor -%}
    {%- endif -%}
    </div>
</div>
