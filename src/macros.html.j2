{# Formatting macros #}
{%- macro formatEmail(email) -%}
  <span class="email"><a href="mailto:{{ email }}">{{ email._value }}</a></span>
{%- endmacro -%}

{%- macro formatOrcid(reply) -%}
  {%- if reply._raw -%}
    <span class="orcid">ORCID: <a href="https://orcid.org/{{ reply._raw['orcid-id'] }}" target="_blank">{{ reply._raw['orcid-id'] }}</a></span>
  {%- else -%}
    <span class="orcid">ORCID: {{ reply._value }}</span>
  {%- endif -%}
{%- endmacro -%}

{%- macro downloadUrlFile(document) -%}
  {%- if document -%}
          <a href="{{ document._url }}" target="_blank">{{document._name}}</a>
  {%- else -%}
          <span class="error">File not found</span>
  {%- endif -%}
{%- endmacro -%}

{%- macro formatROR(organisation) -%}
  {%- if organisation._raw -%}
      {%- for name in organisation._raw.names -%}
        {%- if "ror_display" in name.types -%}
          <a href="{{ organisation._raw.id }}" target="_blank">{{ name.value }}</a>
        {%- endif -%}
      {%- endfor -%}
      {%- for name in organisation._raw.names -%}
        {%- if "acronym" in name.types -%}
          {{- ' ' -}}({{ name.value }})
        {%- endif -%}
      {%- endfor -%}
    </a>
  {%- else -%}
    {{ organisation._value }}
  {%- endif -%}
{%- endmacro -%}

{%- macro formatDetection() -%}
  {# HTML with warnings #}
  {%- if dc.document.format_uuid == "990bad19-516f-4241-b5f2-06aa560a244c" -%}
    HTML_with_warnings
  {%- endif -%}
{%- endmacro -%}

{% macro lowerFirstLetter(string) -%}
  {{ string[:1].lower() ~ string[1:] }}
{%- endmacro %}

{%- macro linkQuestion(questionPath) -%}
  {%- if formatDetection() == "HTML_with_warnings" -%}
    <a href="{{ctx.config.clientUrl}}/projects/{{ctx.project.uuid}}?questionPath={{questionPath}}" class="footnote" title="Question linked to this text" target="_blank" rel="noopener noreferrer">❓</a>
  {%- endif -%}
{%- endmacro -%}

{# Including detection of URL identifier from FAIRsharing #}
{%- macro formatIdentifier(identifier) -%}
  {%- if identifier.type and identifier.type._raw -%}
    <em><a href="{{ identifier.type._raw.homepage }}" target="_blank">{{ identifier.type._raw.abbreviation }}</a></em>:
    {%- if identifier.type._raw.urlPattern and identifier.value and identifier.value._value %}
      <a href="{{ identifier.type._raw.urlPattern | replace("{$id}", identifier.value._value) }}" target="_blank">{{ identifier.type._raw.urlPattern | replace("{$id}", identifier.value._value) }}</a>{{ linkQuestion(identifier.value._path) }}
    {%- elif identifier.type._raw.id == 709 and identifier.value and identifier.value._value %}
      <a href="{{ identifier.value._value }}" target="_blank">{{ identifier.value._value }}</a>{{ linkQuestion(identifier.value._path) }}
    {%- elif identifier.value and identifier.value._value %}
      {{ identifier.value._value }}{{ linkQuestion(identifier.value._path) }}
    {%- else %}
      <em>no value given</em>
    {%- endif -%}
  {%- else -%}
    <em>{{ identifier.type._value if identifier.type._value else "no type of identifier given" }}: {{ identifier.value._value if identifier.value._value else "no value given" }}</em>
  {%- endif -%}
{%- endmacro -%}

{% macro datasetIntro(sharedResource, contextPhrase, allDatasets) -%}
  {%- if sharedResource.isPlanned._value is sameas true -%}
    <p>This {{ contextPhrase }} is <em>planned</em>, and no datasets are currently associated with it.</p>
  {%- elif sharedResource.usedBy | length == allDatasets | length -%}
    <p>
      The same {{ contextPhrase }} applies to all datasets.
    </p>

  {% elif sharedResource.usedBy | length > 0 %}
    {% set datasets = [] %}
    {% for datasetUuid in sharedResource.usedBy %}
      {% set ds = allDatasets | selectattr('uuid', 'equalto', datasetUuid) | first %}
      {% if ds %}
        {% if ds.name %}
          {% do datasets.append('<strong>' ~ ds.name._value ~ '</strong>' ~ linkQuestion(ds.name._path)) %}
        {% else %}
          {% do datasets.append('<strong>(no name)</strong>') %}
        {% endif %}
      {% endif %}
    {% endfor %}
    {% set datasetText = datasets | join(", ") | safe %}
    {%- if datasets | length > 1 -%}
      <p>This {{ contextPhrase }} applies to the following datasets: {{ datasetText }}.</p>
    {%- elif datasets | length == 1 -%}
      <p>This {{ contextPhrase }} applies to the following dataset: {{ datasetText }}.</p>
    {%- endif -%}
  {%- endif -%}
{%- endmacro %}
